    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    tabLayout.Padding = UDim.new(0, 8)
    tabLayout.Parent = tabContainer

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Size = UDim2.new(1, -20, 1, -130)
    content.Position = UDim2.new(0, 10, 0, 124)
    content.BackgroundTransparency = 1
    content.Parent = main

    local pages = {}

    local function createPage(name)
        local page = Instance.new("ScrollingFrame")
        page.Name = name
        page.Size = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 4
        page.ScrollBarImageColor3 = CFG.UI.Accent
        page.Visible = false
        page.Parent = content

        local list = Instance.new("UIListLayout")
        list.Padding = UDim.new(0, 10)
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.Parent = page

        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 10)
        pad.PaddingLeft = UDim.new(0, 10)
        pad.PaddingRight = UDim.new(0, 10)
        pad.PaddingBottom = UDim.new(0, 10)
        pad.Parent = page

        pages[name] = page
        return page
    end

    local pageAimbot = createPage("aimbot")
    local pageESP = createPage("esp")
    local pageSilent = createPage("silent")
    local pageMisc = createPage("misc")

    local function switchPage(name)
        for _, pg in pairs(pages) do pg.Visible = false end
        if pages[name] then pages[name].Visible = true end
    end

    local function addSection(parent, text)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 22)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = CFG.UI.Accent
        lbl.TextSize = 18
        lbl.Font = Enum.Font.GothamBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.LayoutOrder = #parent:GetChildren()
        lbl.Parent = parent
        return lbl
    end

    local function addToggle(parent, text, cfgTable, key, callback)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 42)
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = #parent:GetChildren()
        frame.Parent = parent

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -50, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.TextSize = 15
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = frame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 44, 0, 24)
        btn.Position = UDim2.new(1, -44, 0.5, -12)
        btn.BackgroundColor3 = cfgTable[key] and CFG.UI.Accent or Color3.fromRGB(45, 45, 55)
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = frame
        local btnCorner = Instance.new("UICorner"); btnCorner.CornerRadius = UDim.new(1, 0); btnCorner.Parent = btn
        local btnStroke = Instance.new("UIStroke"); btnStroke.Color = Color3.fromRGB(90, 90, 90); btnStroke.Thickness = 1; btnStroke.Parent = btn

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = UDim2.new(0, cfgTable[key] and 24 or 2, 0.5, -10)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = btn
        local knobCorner = Instance.new("UICorner"); knobCorner.CornerRadius = UDim.new(1, 0); knobCorner.Parent = knob

        local active = cfgTable[key]
        btn.MouseButton1Click:Connect(function()
            active = not active
            cfgTable[key] = active
            btn.BackgroundColor3 = active and CFG.UI.Accent or Color3.fromRGB(45, 45, 55)
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, active and 24 or 2, 0.5, -10)}):Play()
            if callback then callback(active) end
        end)
    end

    local function addSlider(parent, text, min, max, default, cfgTable, key)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 56)
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = #parent:GetChildren()
        frame.Parent = parent

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 120, 0, 20)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = frame

        local valLbl = Instance.new("TextLabel")
        valLbl.Size = UDim2.new(0, 50, 0, 20)
        valLbl.Position = UDim2.new(1, -50, 0, 0)
        valLbl.BackgroundTransparency = 1
        valLbl.Text = tostring(default)
        valLbl.TextColor3 = CFG.UI.Accent
        valLbl.TextSize = 14
        valLbl.Font = Enum.Font.GothamBold
        valLbl.TextXAlignment = Enum.TextXAlignment.Right
        valLbl.Parent = frame

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -10, 0, 6)
        track.Position = UDim2.new(0, 5, 1, -24)
        track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        track.BorderSizePixel = 0
        track.Parent = frame
        local trackCorner = Instance.new("UICorner"); trackCorner.CornerRadius = UDim.new(1, 0); trackCorner.Parent = track

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = CFG.UI.Accent
        fill.BorderSizePixel = 0
        fill.Parent = track
        local fillCorner = Instance.new("UICorner"); fillCorner.CornerRadius = UDim.new(1, 0); fillCorner.Parent = fill

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new((default - min) / (max - min), -7, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = track
        local knobCorner = Instance.new("UICorner"); knobCorner.CornerRadius = UDim.new(1, 0); knobCorner.Parent = knob

        local dragging = false
        local function update(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local value = min + (max - min) * rel
            value = math.floor(value * 100) / 100
            cfgTable[key] = value
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -7, 0.5, -7)
            valLbl.Text = tostring(value)
        end
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end
        end)
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
        end)
    end

    local function addKeybind(parent, text, cfgTable, key)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 40)
        frame.BackgroundTransparency = 1
        frame.LayoutOrder = #parent:GetChildren()
        frame.Parent = parent

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -100, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = frame

        local kbBtn = Instance.new("TextButton")
        kbBtn.Size = UDim2.new(0, 90, 0, 28)
        kbBtn.Position = UDim2.new(1, -90, 0.5, -14)
        kbBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        kbBtn.Text = tostring(cfgTable[key])
        kbBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        kbBtn.Font = Enum.Font.GothamBold
        kbBtn.TextSize = 14
        kbBtn.Parent = frame
        local kbCorner = Instance.new("UICorner"); kbCorner.CornerRadius = UDim.new(0, 8); kbCorner.Parent = kbBtn

        local listening = false
        kbBtn.MouseButton1Click:Connect(function()
            listening = true
            kbBtn.Text = "..."
        end)
        UserInputService.InputBegan:Connect(function(input)
            if not listening then return end
            listening = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                cfgTable[key] = input.KeyCode
                kbBtn.Text = tostring(input.KeyCode)
            elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                cfgTable[key] = input.UserInputType
                kbBtn.Text = tostring(input.UserInputType)
            end
        end)
    end

    -- aimbot page
    addSection(pageAimbot, "aimbot")
    addToggle(pageAimbot, "enabled", CFG.Aimbot, "Enabled")
    addToggle(pageAimbot, "silent aim (camera stays)", CFG.Aimbot, "Silent")
    addToggle(pageAimbot, "team check", CFG.Aimbot, "TeamCheck")
    addToggle(pageAimbot, "wall check", CFG.Aimbot, "WallCheck")
    addToggle(pageAimbot, "smooth aim", CFG.Aimbot, "Smooth")
    addSlider(pageAimbot, "smoothness", 0.05, 1, CFG.Aimbot.Smoothness, CFG.Aimbot, "Smoothness")
    addSlider(pageAimbot, "fov radius", 50, 500, CFG.Aimbot.FOVRadius, CFG.Aimbot, "FOVRadius")
    addSlider(pageAimbot, "prediction", 0, 0.5, CFG.Aimbot.Prediction, CFG.Aimbot, "Prediction")
    addKeybind(pageAimbot, "aimbot key", CFG.Aimbot, "Key")

    addSection(pageAimbot, "bone")
    local boneBtn = Instance.new("TextButton")
    boneBtn.Size = UDim2.new(1, 0, 0, 34)
    boneBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    boneBtn.Text = CFG.Aimbot.Bone
    boneBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    boneBtn.Font = Enum.Font.GothamBold
    boneBtn.TextSize = 16
    boneBtn.Parent = pageAimbot
    local boneCorner = Instance.new("UICorner"); boneCorner.CornerRadius = UDim.new(0, 8); boneCorner.Parent = boneBtn
    local bones = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftHand", "RightHand"}
    local boneIdx = 1
    boneBtn.MouseButton1Click:Connect(function()
        boneIdx = boneIdx % #bones + 1
        CFG.Aimbot.Bone = bones[boneIdx]
        boneBtn.Text = CFG.Aimbot.Bone
    end)

    -- esp page
    addSection(pageESP, "esp")
    addToggle(pageESP, "enabled", CFG.ESP, "Enabled")
    addToggle(pageESP, "boxes", CFG.ESP, "Boxes")
    addToggle(pageESP, "names", CFG.ESP, "Names")
    addToggle(pageESP, "distance", CFG.ESP, "Distance")
    addToggle(pageESP, "health bars", CFG.ESP, "Health")
    addToggle(pageESP, "tracers", CFG.ESP, "Tracers")
    addToggle(pageESP, "chams", CFG.ESP, "Chams")
    addSlider(pageESP, "max distance", 100, 5000, CFG.ESP.MaxDistance, CFG.ESP, "MaxDistance")

    -- silent aim page
    addSection(pageSilent, "silent aim (ray redirect)")
    addToggle(pageSilent, "enabled", CFG.SilentAim, "Enabled")
    addToggle(pageSilent, "team check", CFG.SilentAim, "TeamCheck")
    addSlider(pageSilent, "hit chance", 0, 100, CFG.SilentAim.HitChance, CFG.SilentAim, "HitChance")
    local silentPartBtn = Instance.new("TextButton")
    silentPartBtn.Size = UDim2.new(1, 0, 0, 34)
    silentPartBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    silentPartBtn.Text = CFG.SilentAim.TargetPart
    silentPartBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    silentPartBtn.Font = Enum.Font.GothamBold
    silentPartBtn.TextSize = 16
    silentPartBtn.Parent = pageSilent
    local spCorner = Instance.new("UICorner"); spCorner.CornerRadius = UDim.new(0, 8); spCorner.Parent = silentPartBtn
    local sParts = {"Head", "HumanoidRootPart", "UpperTorso"}
    local sIdx = 1
    silentPartBtn.MouseButton1Click:Connect(function()
        sIdx = sIdx % #sParts + 1
        CFG.SilentAim.TargetPart = sParts[sIdx]
        silentPartBtn.Text = CFG.SilentAim.TargetPart
    end)

    -- misc page
    addSection(pageMisc, "misc")
    addKeybind(pageMisc, "ui toggle", CFG.UI, "ToggleKey")
    addKeybind(pageMisc, "unload", CFG.UI, "UnloadKey")

    local tabButtons = {}
    local function makeTab(name)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 160, 1, 0)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        btn.Text = name:upper()
        btn.TextColor3 = Color3.fromRGB(160, 160, 160)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = tabContainer
        local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 10); corner.Parent = btn
        btn.MouseButton1Click:Connect(function()
            for _, b in pairs(tabButtons) do
                b.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                b.TextColor3 = Color3.fromRGB(160, 160, 160)
            end
            btn.BackgroundColor3 = CFG.UI.Accent
            btn.TextColor3 = Color3.fromRGB(15, 15, 20)
            switchPage(name)
        end)
        table.insert(tabButtons, btn)
        return btn
    end

    makeTab("aimbot")
    makeTab("esp")
    makeTab("silent aim")
    makeTab("misc")
    tabButtons[1]:MouseButton1Click()

    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        state.UIOpen = false
        main.Visible = false
    end)
    minBtn.MouseButton1Click:Connect(function()
        state.UIOpen = false
        main.Visible = false
    end)

    state.GUI = {Gui = gui, Main = main}
    return gui
end

local gui = buildUI()

-- input

local conns = {}

table.insert(conns, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == CFG.Aimbot.Key then
        state.AimbotActive = true
        state.MouseHeld = true
    end
    if input.KeyCode == CFG.UI.ToggleKey and gui then
        state.UIOpen = not state.UIOpen
        if state.GUI.Main then state.GUI.Main.Visible = state.UIOpen end
    end
    if input.KeyCode == CFG.UI.UnloadKey then
        unload()
    end
end))

table.insert(conns, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == CFG.Aimbot.Key then
        state.AimbotActive = false
        state.MouseHeld = false
    end
end))

-- silent aim target tracker

local function updateSilentTarget()
    if not CFG.SilentAim.Enabled then
        state.SilentTarget = nil
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local origin = cam.CFrame.Position
    local bestPart, bestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if CFG.SilentAim.TeamCheck then
            local myTeam = LocalPlayer.Team
            local theirTeam = player.Team
            if myTeam and theirTeam and theirTeam == myTeam then continue end
        end
        local char = getCharacter(player)
        local hum = getHumanoid(char)
        local part = getBone(char, CFG.SilentAim.TargetPart)
        if not hum or hum.Health <= 0 or not part then continue end
        local pos, onScreen = worldToScreen(part.Position)
        if not onScreen then continue end
        local dist = (pos - center).Magnitude
        if dist > CFG.Aimbot.FOVRadius then continue end
        if dist < bestDist then
            bestDist = dist
            bestPart = part
        end
    end
    state.SilentTarget = bestPart and bestPart.Position or nil
end

installSilentAimHook()

-- main loop

table.insert(conns, RunService.RenderStepped:Connect(function()
    updateESP()
    updateFOV()
    if CFG.SilentAim.Enabled then
        updateSilentTarget()
    else
        state.SilentTarget = nil
    end
    if CFG.Aimbot.Enabled and not CFG.Aimbot.Silent then
        if state.AimbotActive then
            local target = getClosestToCrosshair()
            if target then aimAt(target) end
        end
    end
end))

function unload()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    for _, data in pairs(state.ESPData) do
        data.Box:Remove()
        data.BoxOutline:Remove()
        data.Name:Remove()
        data.Dist:Remove()
        data.HealthBar:Remove()
        data.HealthBarBack:Remove()
        data.Tracer:Remove()
        data.Highlight:Destroy()
    end
    state.ESPData = {}
    if fovCircle then removeDrawing(fovCircle); fovCircle = nil end
    if state.GUI.Gui then pcall(function() state.GUI.Gui:Destroy() end) end
    state.GUI = {}
end
