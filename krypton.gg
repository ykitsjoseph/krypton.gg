-- ============================================================
-- INTERNALS
-- ============================================================
local FighterController, CameraController, ControlsController, MechanicsController
pcall(function() FighterController = require(LocalPlayer.PlayerScripts.Controllers.FighterController) end)
pcall(function() CameraController = require(LocalPlayer.PlayerScripts.Controllers.CameraController) end)
pcall(function() ControlsController = require(LocalPlayer.PlayerScripts.Controllers.ControlsController) end)
pcall(function() MechanicsController = require(LocalPlayer.PlayerScripts.Controllers.MechanicsController) end)

local function getLocalFighter() return FighterController and FighterController.LocalFighter end

local function getEnemies()
    local out = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            table.insert(out, { player = p, character = p.Character })
        end
    end
    return out
end

local function isTeammate(p)
    local lf = getLocalFighter()
    if lf and lf.Get and p and p.Get then
        local ok,a = pcall(function() return lf:Get("Team") end)
        local ok2,b = pcall(function() return p:Get("Team") end)
        if ok and ok2 and a and b then return a == b end
    end
    return false
end

local function getPart(char, name)
    if not char then return nil end
    local p = char:FindFirstChild(name, true)
    if p and p:IsA("BasePart") then return p end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function worldToScreen(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local function isVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local hit = Workspace:Raycast(origin, dir, params)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(part.Parent)
end

local function predict(part, amt)
    if not part or not part.Parent then return part and part.Position end
    amt = amt or 0.135
    local vel = Vector3.zero
    pcall(function()
        local root = part.Parent:FindFirstChild("HumanoidRootPart")
        if root then vel = root.Velocity end
    end)
    return part.Position + vel * amt
end

-- ============================================================
-- TARGETING
-- ============================================================
local function getBestTarget(cfg, partName)
    local best, bestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local fov = (cfg and cfg.FOV) or 180
    for _, e in ipairs(getEnemies()) do
        if isTeammate(e.player) then continue end
        local part = getPart(e.character, partName or "Head")
        if not part then continue end
        local sp, on = worldToScreen(part.Position)
        if not on then continue end
        local dist = (sp - center).Magnitude
        if dist > fov then continue end
        if cfg and cfg.WallCheck and not isVisible(part) then continue end
        if dist < bestDist then bestDist = dist; best = { player = e.player, character = e.character, part = part, screen = sp } end
    end
    return best
end

-- ============================================================
-- SILENT AIM
-- ============================================================
local SilentTarget = nil
local function silentAimTick()
    if not Cfg.Combat.SilentAim.Enabled then SilentTarget = nil; return end
    SilentTarget = getBestTarget(Cfg.Combat.SilentAim, Cfg.Combat.SilentAim.ClosestPart or "Head")
end

-- ============================================================
-- AIMBOT
-- ============================================================
local function aimbotTick()
    if not Cfg.Combat.Aimbot.Enabled then return end
    local lf = getLocalFighter()
    if Cfg.Combat.Aimbot.OnScope and lf then
        local ok, scoped = pcall(function() return lf:Get("IsScoped") end)
        if ok and not scoped then return end
    end
    local t = getBestTarget(Cfg.Combat.Aimbot, Cfg.Combat.Aimbot.Part or "Head")
    if not t then return end
    local targetPos = t.part.Position
    if Cfg.Combat.Aimbot.Prediction then targetPos = predict(t.part, Cfg.Combat.Aimbot.PredictionAmount) end
    local cam = Camera.CFrame
    local desired = CFrame.new(cam.Position, targetPos)
    local smooth = math.clamp(Cfg.Combat.Aimbot.Smoothness or 0.15, 0.01, 1)
    if Cfg.Combat.Aimbot.Flick then smooth = 1 end
    Camera.CFrame = cam:Lerp(desired, smooth)
end

-- ============================================================
-- TRIGGERBOT
-- ============================================================
local lastShot = 0
local function triggerbotTick()
    if not Cfg.Combat.Triggerbot.Enabled then return end
    local now = tick()
    if now - lastShot < (Cfg.Combat.Triggerbot.ShootDelay or 0.1) then return end
    local cfg = { FOV = 15, WallCheck = Cfg.Combat.Triggerbot.Checks.Wall }
    local t = getBestTarget(cfg, Cfg.Combat.Triggerbot.HeadOnly and "Head" or "Head")
    if not t then return end
    if Cfg.Combat.Triggerbot.TeamCheck and isTeammate(t.player) then return end
    task.delay(Cfg.Combat.Triggerbot.Delay or 0.05, function()
        pcall(function() UserInputService:SimulateMouseButton1Press(Vector2.zero, 0) end)
    end)
    lastShot = now
end

-- ============================================================
-- RAGEBOT
-- ============================================================
local function ragebotTick()
    if not Cfg.Combat.Ragebot.Enabled then return end
    local t = getBestTarget({ FOV = 360, WallCheck = false }, "Head")
    if not t then return end
    local pos = predict(t.part, 0.135)
    Camera.CFrame = CFrame.new(Camera.CFrame.Position, pos)
    pcall(function() UserInputService:SimulateMouseButton1Press(Vector2.zero, 0) end)
    if Cfg.Combat.Ragebot.AutoCrouch then
        pcall(function()
            if MechanicsController and MechanicsController.Crouch then MechanicsController:Crouch(true) end
        end)
    end
end

-- ============================================================
-- ANTI-AIM
-- ============================================================
local function antiAimTick()
    if not Cfg.Combat.AntiAim.Enabled then return end
    pcall(function()
        local cf = Camera.CFrame
        local pitch = Cfg.Combat.AntiAim.Pitch == "down" and -89 or 89
        local yaw = (tick() * 100) % 360
        if Cfg.Combat.AntiAim.YawMode == "jitter" then yaw = (yaw > 180) and (yaw - 180) or yaw
        elseif Cfg.Combat.AntiAim.YawMode == "spin" then yaw = (tick() * Cfg.Combat.AntiAim.YawAngle) % 360 end
        Camera.CFrame = CFrame.new(cf.Position) * CFrame.Angles(math.rad(pitch), math.rad(yaw), 0)
    end)
end

-- ============================================================
-- ESP + CHAMS
-- ============================================================
local espObjects = {}
local chamsHighlights = {}

local function createESP(player)
    if espObjects[player] then return espObjects[player] end
    local box = Drawing.new("Square"); box.Visible = false
    local name = Drawing.new("Text"); name.Visible = false; name.Center = true; name.Outline = true
    local tracer = Drawing.new("Line"); tracer.Visible = false
    local dist = Drawing.new("Text"); dist.Visible = false; dist.Center = true; dist.Outline = true
    local health = Drawing.new("Line"); health.Visible = false; health.Thickness = 2
    local weapon = Drawing.new("Text"); weapon.Visible = false; weapon.Center = true; weapon.Outline = true
    local skeleton = {}
    for i = 1, 16 do
        local l = Drawing.new("Line"); l.Visible = false; skeleton[i] = l
    end
    local obj = { box = box, name = name, tracer = tracer, dist = dist, health = health, weapon = weapon, skeleton = skeleton, player = player }
    espObjects[player] = obj
    return obj
end

local function removeESP(player)
    local o = espObjects[player]
    if o then
        for _, d in pairs(o) do
            if type(d) == "userdata" then pcall(function() d:Remove() end)
            elseif type(d) == "table" then for _, l in ipairs(d) do pcall(function() l:Remove() end) end end
        end
        espObjects[player] = nil
    end
    if chamsHighlights[player] then
        pcall(function() chamsHighlights[player]:Destroy() end)
        chamsHighlights[player] = nil
    end
end

local function applyChams(char, player)
    if not Cfg.ESP.Chams.Enabled then
        if chamsHighlights[player] then pcall(function() chamsHighlights[player]:Destroy() end); chamsHighlights[player] = nil end
        return
    end
    if chamsHighlights[player] and chamsHighlights[player].Parent then return end
    if chamsHighlights[player] then pcall(function() chamsHighlights[player]:Destroy() end) end
    if Cfg.ESP.Chams.Kind == "Highlight" then
        local hl = Instance.new("Highlight")
        hl.Name = "RivalsChams"
        hl.FillColor = Cfg.ESP.Chams.Fill
        hl.FillTransparency = Cfg.ESP.Chams.FillTransparency
        hl.OutlineColor = Cfg.ESP.Chams.Outline
        hl.OutlineTransparency = Cfg.ESP.Chams.OutlineTransparency
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
        chamsHighlights[player] = hl
        if Cfg.ESP.Chams.Glow then
            pcall(function()
                local glow = Instance.new("Highlight")
                glow.Name = "RivalsGlow"
                glow.FillColor = Cfg.ESP.Chams.GlowColor
                glow.FillTransparency = 0.7
                glow.OutlineTransparency = 1
                glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                glow.Parent = char
            end)
        end
    end
end

local function espTick()
    if not Cfg.ESP.Enabled then
        for _, o in pairs(espObjects) do
            for k,v in pairs(o) do
                if type(v)=="userdata" and v.Visible ~= nil then v.Visible = false
                elseif type(v)=="table" then for _,l in ipairs(v) do l.Visible = false end end
            end
        end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if isTeammate(p) and not Cfg.ESP.ShowTeammates then
            if espObjects[p] then removeESP(p) end; continue
        end
        local char = p.Character
        if not char then if espObjects[p] then removeESP(p) end; continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not root or not head then if espObjects[p] then removeESP(p) end; continue end
        local sp, on = worldToScreen(root.Position)
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > Cfg.ESP.MaxDistance then
            if espObjects[p] then for k,v in pairs(espObjects[p]) do if type(v)=="userdata" and v.Visible~=nil then v.Visible=false elseif type(v)=="table" then for _,l in ipairs(v) do l.Visible=false end end end end
            continue
        end
        if not on then
            if espObjects[p] then for k,v in pairs(espObjects[p]) do if type(v)=="userdata" and v.Visible~=nil then v.Visible=false elseif type(v)=="table" then for _,l in ipairs(v) do l.Visible=false end end end end
            continue
        end
        local o = createESP(p)
        applyChams(char, p)
        local top = worldToScreen(head.Position + Vector3.new(0,0.5,0))
        local bot = worldToScreen(root.Position - Vector3.new(0,3,0))
        local h = math.abs(top.Y - bot.Y)
        local w = h / 2
        if Cfg.ESP.Box.Enabled then
            o.box.Size = Vector2.new(w, h)
            o.box.Position = Vector2.new(sp.X - w/2, top.Y)
            o.box.Visible = true
            o.box.Color = Cfg.ESP.Box.Color
            o.box.Thickness = Cfg.ESP.Box.Thickness
            o.box.Filled = Cfg.ESP.Box.Filled
        else o.box.Visible = false end
        if Cfg.ESP.Name.Enabled then
            o.name.Text = (Cfg.ESP.Name.UseDisplayName and p.DisplayName) or p.Name
            o.name.Position = Vector2.new(sp.X, top.Y - 14)
            o.name.Visible = true
            o.name.Color = Cfg.ESP.Name.Color
            o.name.Size = Cfg.ESP.Name.Size
        else o.name.Visible = false end
        if Cfg.ESP.Distance.Enabled then
            o.dist.Text = math.floor(dist) .. "m"
            o.dist.Position = Vector2.new(sp.X, bot.Y + 2)
            o.dist.Visible = true
            o.dist.Color = Cfg.ESP.Distance.Color
            o.dist.Size = Cfg.ESP.Distance.Size
        else o.dist.Visible = false end
        if Cfg.ESP.HealthBar.Enabled then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hp = hum and hum.Health or 100
            local maxhp = hum and hum.MaxHealth or 100
            local ratio = math.clamp(hp/maxhp, 0, 1)
            local barH = h * ratio
            o.health.From = Vector2.new(sp.X - w/2 - 4, bot.Y)
            o.health.To = Vector2.new(sp.X - w/2 - 4, bot.Y - barH)
            o.health.Visible = true
            o.health.Color = Cfg.ESP.HealthBar.ColorMode == "Reactive" and Color3.fromRGB(255*(1-ratio), 255*ratio, 50) or Cfg.ESP.HealthBar.Color
            o.health.Thickness = Cfg.ESP.HealthBar.Width
        else o.health.Visible = false end
        if Cfg.ESP.HeldWeapon.Enabled then
            o.weapon.Text = "weapon"
            o.weapon.Position = Vector2.new(sp.X, bot.Y + 14)
            o.weapon.Visible = false
        else o.weapon.Visible = false end
        if Cfg.ESP.Tracer.Enabled then
            local from = Cfg.ESP.Tracer.From
            local origin = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            if from == "Center" then origin = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            elseif from == "Top" then origin = Vector2.new(Camera.ViewportSize.X/2, 0)
            elseif from == "Mouse" then origin = UserInputService:GetMouseLocation() end
            local to = Cfg.ESP.Tracer.To == "Head" and top or bot
            o.tracer.From = origin
            o.tracer.To = Vector2.new(to.X, to.Y)
            o.tracer.Visible = true
            o.tracer.Color = Cfg.ESP.Tracer.Color
            o.tracer.Thickness = Cfg.ESP.Tracer.Thickness
        else o.tracer.Visible = false end
        -- skeleton
        if Cfg.ESP.Skeleton.Enabled then
            -- basic skeleton lines (head-shoulder-hip chain)
            local function gp(n) local part = char:FindFirstChild(n); return part and worldToScreen(part.Position) end
            local pts = {
                gp("Head"), gp("UpperTorso") or gp("Torso"),
                gp("LeftUpperArm") or gp("Left Arm"), gp("RightUpperArm") or gp("Right Arm"),
                gp("LeftUpperLeg") or gp("Left Leg"), gp("RightUpperLeg") or gp("Right Leg"),
            }
            for _, l in ipairs(o.skeleton) do l.Visible = false end
        else
            for _, l in ipairs(o.skeleton) do l.Visible = false end
        end
    end
end

-- ============================================================
-- FOV CIRCLE
-- ============================================================
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
local function fovTick()
    if not Cfg.Visuals.FOVCircle.Enabled then fovCircle.Visible = false; return end
    fovCircle.Visible = true
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    fovCircle.Radius = Cfg.Visuals.FOVCircle.Radius
    fovCircle.Color = Cfg.Visuals.FOVCircle.Color
    fovCircle.Filled = Cfg.Visuals.FOVCircle.Filled
    fovCircle.Thickness = Cfg.Visuals.FOVCircle.Thickness
end

-- ============================================================
-- CROSSHAIR
-- ============================================================
local crossLines = {}
for i = 1, 4 do
    local l = Drawing.new("Line"); l.Visible = false; l.Thickness = 1
    crossLines[i] = l
end
local crossDot = Drawing.new("Circle"); crossDot.Visible = false; crossDot.Filled = true; crossDot.Radius = 1
local function crosshairTick()
    if not Cfg.Visuals.Crosshair.Enabled then
        for _,l in ipairs(crossLines) do l.Visible = false end
        crossDot.Visible = false; return
    end
    local c = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local size = Cfg.Visuals.Crosshair.Size
    local gap = Cfg.Visuals.Crosshair.Gap
    local thick = Cfg.Visuals.Crosshair.Thickness
    local col = Cfg.Visuals.Crosshair.Color
    crossLines[1].From = Vector2.new(c.X, c.Y - gap - size); crossLines[1].To = Vector2.new(c.X, c.Y - gap)
    crossLines[2].From = Vector2.new(c.X, c.Y + gap); crossLines[2].To = Vector2.new(c.X, c.Y + gap + size)
    crossLines[3].From = Vector2.new(c.X - gap - size, c.Y); crossLines[3].To = Vector2.new(c.X - gap, c.Y)
    crossLines[4].From = Vector2.new(c.X + gap, c.Y); crossLines[4].To = Vector2.new(c.X + gap + size, c.Y)
    for _,l in ipairs(crossLines) do l.Visible = true; l.Color = col; l.Thickness = thick end
    if Cfg.Visuals.Crosshair.Dot then crossDot.Visible = true; crossDot.Position = c; crossDot.Color = col; crossDot.Radius = 1
    else crossDot.Visible = false end
end

-- ============================================================
-- STAFF DETECTOR
-- ============================================================
local staffList = {}
local lastStaffCheck = 0
local function isStaff(player)
    if Cfg.Misc.StaffDetector.KnownStaff[player.UserId] then return true end
    if Cfg.Misc.StaffDetector.KnownStaff[player.Name] then return true end
    pcall(function()
        local attr = player:GetAttribute("IsStaff") or player:GetAttribute("IsModerator") or player:GetAttribute("IsAdmin")
        if attr then staffList[player] = true end
    end)
    pcall(function()
        if player.Backpack and player.Backpack:FindFirstChild("Admin") then staffList[player] = true end
        if player.Character and player.Character:FindFirstChild("Admin") then staffList[player] = true end
    end)
    return staffList[player] == true
end

local function staffDetectorTick()
    if not Cfg.Misc.StaffDetector.Enabled then return end
    local now = tick()
    if now - lastStaffCheck < Cfg.Misc.StaffDetector.CheckInterval then return end
    lastStaffCheck = now
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if isStaff(p) and not staffList[p] then
            staffList[p] = true
            if Cfg.Misc.StaffDetector.Notify then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Staff Detected", Text = p.Name .. " flagged as staff", Duration = 5,
                    })
                end)
            end
            if Cfg.Misc.StaffDetector.Kick then pcall(function() LocalPlayer:Kick("Staff detected: " .. p.Name) end) end
            if Cfg.Misc.StaffDetector.AutoLeave then pcall(function() game:Shutdown() end) end
        end
    end
end

-- ============================================================
-- MOD DETECTOR
-- ============================================================
local modList = {}
local lastModCheck = 0
local function isMod(player)
    if Cfg.Misc.ModDetector.Moderators[player.UserId] then return true end
    if Cfg.Misc.ModDetector.Moderators[player.Name] then return true end
    pcall(function()
        if player:GetAttribute("IsModerator") or player:GetAttribute("Mod") then modList[player] = true end
    end)
    return modList[player] == true
end

local function modDetectorTick()
    if not Cfg.Misc.ModDetector.Enabled then return end
    local now = tick()
    if now - lastModCheck < Cfg.Misc.ModDetector.CheckInterval then return end
    lastModCheck = now
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if isMod(p) and not modList[p] then
            modList[p] = true
            if Cfg.Misc.ModDetector.Notify then
                pcall(function()
                    game:GetService("StarterGui"):SetCore("SendNotification", {
                        Title = "Moderator Detected", Text = p.Name .. " flagged as moderator", Duration = 5,
                    })
                end)
            end
            if Cfg.Misc.ModDetector.Kick then pcall(function() LocalPlayer:Kick("Moderator detected: " .. p.Name) end) end
        end
    end
end

-- ============================================================
-- MOVEMENT / MISC
-- ============================================================
local function miscTick()
    if Cfg.Misc.WalkSpeed.Enabled then
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = Cfg.Misc.WalkSpeed.Value end
        end)
    end
    if Cfg.Misc.JumpPower.Enabled then
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.JumpPower = Cfg.Misc.JumpPower.Value end
        end)
    end
    if Cfg.Misc.Fly.Enabled then
        pcall(function()
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local dir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
                root.Velocity = dir.Magnitude > 0 and dir.Unit * Cfg.Misc.Fly.Speed or Vector3.zero
                local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.PlatformStand = true end
            end
        end)
    else
        pcall(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end)
    end
    if Cfg.Misc.Thirdperson.Enabled then
        pcall(function()
            Camera.CameraType = Enum.CameraType.Scriptable
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local offset = CFrame.new(Cfg.Misc.Thirdperson.X, Cfg.Misc.Thirdperson.Y, Cfg.Misc.Thirdperson.Z)
                Camera.CFrame = root.CFrame * offset
            end
        end)
    else
        pcall(function() Camera.CameraType = Enum.CameraType.Custom end)
    end
    if Cfg.Misc.DestroyTripmine.Enabled then
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name:lower():find("tripmine") or obj.Name:lower():find("trip_mine") then
                    pcall(function() obj:Destroy() end)
                end
            end
        end)
    end
    if Cfg.Misc.RemoveSmoke then
        pcall(function()
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Smoke") or obj.Name:lower():find("smoke") then
                    pcall(function() obj:Destroy() end)
                end
            end
        end)
    end
    if Cfg.Misc.AntiFlash then
        pcall(function()
            local gui = LocalPlayer.PlayerGui
            for _, g in ipairs(gui:GetDescendants()) do
                if g:IsA("ImageLabel") and g.Image:lower():find("flash") then g.Visible = false end
            end
        end)
    end
end

UserInputService.JumpRequest:Connect(function()
    if not Cfg.Misc.InfiniteJump then return end
    pcall(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)
end)

-- ============================================================
-- WORLD VISUALS
-- ============================================================
local function worldTick()
    if not Cfg.Visuals.World.Lighting.Enabled then return end
    pcall(function()
        Lighting.Brightness = Cfg.Visuals.World.Lighting.Brightness
        Lighting.ClockTime = Cfg.Visuals.World.Lighting.ClockTime
        Lighting.ExposureCompensation = Cfg.Visuals.World.Lighting.ExposureCompensation
        Lighting.FogEnd = Cfg.Visuals.World.Lighting.FogEnd
        Lighting.OutdoorAmbient = Cfg.Visuals.World.Lighting.OutdoorAmbient
        Lighting.GlobalShadows = Cfg.Visuals.World.Lighting.GlobalShadows
        Lighting.Technology = Cfg.Visuals.World.Lighting.Technology
    end)
end

-- ============================================================
-- TARGET HUD
-- ============================================================
local targetHud = nil
local function createTargetHud()
    if targetHud then return targetHud end
    local sg = Instance.new("ScreenGui"); sg.Name = "TargetHUD"; sg.ResetOnSpawn = false; sg.Parent = gethui()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 80); frame.Position = UDim2.new(1, -240, 0.5, -40)
    frame.BackgroundColor3 = Color3.fromRGB(20,20,25); frame.BorderSizePixel = 0; frame.Visible = false; frame.Parent = sg
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,6); corner.Parent = frame
    local name = Instance.new("TextLabel"); name.Size = UDim2.new(1,-10,0,20); name.Position = UDim2.new(0,5,0,5)
    name.Text = ""; name.TextColor3 = Color3.fromRGB(255,255,255); name.BackgroundTransparency = 1
    name.Font = Enum.Font.GothamBold; name.TextSize = 14; name.TextXAlignment = Enum.TextXAlignment.Left; name.Parent = frame
    local hp = Instance.new("TextLabel"); hp.Size = UDim2.new(1,-10,0,16); hp.Position = UDim2.new(0,5,0,28)
    hp.Text = ""; hp.TextColor3 = Color3.fromRGB(50,220,90); hp.BackgroundTransparency = 1
    hp.Font = Enum.Font.Gotham; hp.TextSize = 12; hp.TextXAlignment = Enum.TextXAlignment.Left; hp.Parent = frame
    local dist = Instance.new("TextLabel"); dist.Size = UDim2.new(1,-10,0,16); dist.Position = UDim2.new(0,5,0,48)
    dist.Text = ""; dist.TextColor3 = Color3.fromRGB(200,200,200); dist.BackgroundTransparency = 1
    dist.Font = Enum.Font.Gotham; dist.TextSize = 12; dist.TextXAlignment = Enum.TextXAlignment.Left; dist.Parent = frame
    targetHud = { gui = sg, frame = frame, name = name, hp = hp, dist = dist }
    return targetHud
end

local function targetHudTick()
    if not Cfg.Visuals.TargetHUD.Enabled then
        if targetHud then targetHud.frame.Visible = false end; return
    end
    local hud = createTargetHud()
    local t = nil
    if Cfg.Combat.SilentAim.Enabled then t = SilentTarget end
    if not t and Cfg.Combat.Aimbot.Enabled then t = getBestTarget(Cfg.Combat.Aimbot, Cfg.Combat.Aimbot.Part) end
    if not t and Cfg.Combat.Ragebot.Enabled then t = getBestTarget({FOV=360,WallCheck=false}, "Head") end
    if t and t.player and t.part then
        hud.frame.Visible = true
        hud.name.Text = t.player.DisplayName or t.player.Name
        local hum = t.character:FindFirstChildOfClass("Humanoid")
        if hum then hud.hp.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
        local d = (t.part.Position - Camera.CFrame.Position).Magnitude
        hud.dist.Text = "Dist: " .. math.floor(d) .. "m"
    else
        hud.frame.Visible = false
    end
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
local heartbeat = RunService.Heartbeat:Connect(function(dt)
    if K.destroyed then return end
    pcall(silentAimTick); pcall(aimbotTick); pcall(triggerbotTick)
    pcall(function() if Cfg.Combat.Ragebot.Enabled then ragebotTick() end end)
    pcall(function() if Cfg.Combat.AntiAim.Enabled then antiAimTick() end end)
    pcall(espTick); pcall(fovTick); pcall(crosshairTick); pcall(miscTick)
    pcall(worldTick); pcall(staffDetectorTick); pcall(modDetectorTick); pcall(targetHudTick)
end)
K.track(heartbeat)

-- ============================================================
-- UNLOAD
-- ============================================================
function K.Unload()
    K.destroyed = true
    pcall(function() heartbeat:Disconnect() end)
    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    pcall(function() fovCircle:Remove() end)
    for _, l in ipairs(crossLines) do pcall(function() l:Remove() end) end
    pcall(function() crossDot:Remove() end)
    if targetHud then pcall(function() targetHud.gui:Destroy() end) end
    for _, c in ipairs(K.connections) do pcall(function() c:Disconnect() end) end
    for _, f in ipairs(K.cleanups) do pcall(f) end
end

-- ============================================================
-- UI — TABBED
-- ============================================================
local TABS = { "Aimbot", "Silent Aim", "Triggerbot", "ESP", "Misc", "Visuals", "Configs" }

local function makeUI()
    local sg = Instance.new("ScreenGui")
    sg.Name = "RivalsUnifiedV3"; sg.ResetOnSpawn = false
    sg.Parent = gethui()

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 520, 0, 580)
    frame.Position = UDim2.new(0.5, -260, 0.5, -290)
    frame.BackgroundColor3 = Color3.fromRGB(16,16,22)
    frame.BorderSizePixel = 0
    frame.Parent = sg
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,10); corner.Parent = frame

    -- title bar
    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1,0,0,34); titleBar.BackgroundColor3 = Color3.fromRGB(24,24,34)
    titleBar.BorderSizePixel = 0; titleBar.Parent = frame
    local titleCorner = Instance.new("UICorner"); titleCorner.CornerRadius = UDim.new(0,10); titleCorner.Parent = titleBar
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1,-120,1,0); titleLbl.Position = UDim2.new(0,12,0,0)
    titleLbl.Text = "Rivals Unified v3"; titleLbl.TextColor3 = Color3.fromRGB(255,255,255)
    titleLbl.BackgroundTransparency = 1; titleLbl.Font = Enum.Font.GothamBold; titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left; titleLbl.Parent = titleBar
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0,28,0,24); closeBtn.Position = UDim2.new(1,-34,0,5)
    closeBtn.Text = "X"; closeBtn.TextColor3 = Color3.fromRGB(255,100,100)
    closeBtn.BackgroundColor3 = Color3.fromRGB(40,20,20); closeBtn.Font = Enum.Font.GothamBold; closeBtn.TextSize = 12
    closeBtn.Parent = titleBar
    local cbC = Instance.new("UICorner"); cbC.CornerRadius = UDim.new(0,4); cbC.Parent = closeBtn
    closeBtn.MouseButton1Click:Connect(function() sg:Destroy() end)

    -- tab bar
    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1,-8,0,30); tabBar.Position = UDim2.new(0,4,0,38)
    tabBar.BackgroundColor3 = Color3.fromRGB(20,20,28); tabBar.BorderSizePixel = 0; tabBar.Parent = frame
    local tabCorner = Instance.new("UICorner"); tabCorner.CornerRadius = UDim.new(0,6); tabCorner.Parent = tabBar
    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal; tabLayout.Padding = UDim.new(0,2); tabLayout.Parent = tabBar
    local tabPad = Instance.new("UIPadding"); tabPad.PaddingLeft = UDim.new(0,4); tabPad.PaddingTop = UDim.new(0,3); tabPad.Parent = tabBar

    -- content area
    local contentArea = Instance.new("Frame")
    contentArea.Size = UDim2.new(1,-8,1,-76); contentArea.Position = UDim2.new(0,4,0,72)
    contentArea.BackgroundColor3 = Color3.fromRGB(20,20,28); contentArea.BorderSizePixel = 0; contentArea.Parent = frame
    local caCorner = Instance.new("UICorner"); caCorner.CornerRadius = UDim.new(0,6); caCorner.Parent = contentArea

    local tabButtons = {}
    local tabFrames = {}

    local function makeTabFrame(name)
        local f = Instance.new("ScrollingFrame")
        f.Name = name; f.Size = UDim2.new(1,0,1,0)
        f.BackgroundTransparency = 1; f.BorderSizePixel = 0
        f.ScrollBarThickness = 4; f.CanvasSize = UDim2.new(0,0,0,0)
        f.AutomaticCanvasSize = Enum.AutomaticSize.Y
        f.Visible = false; f.Parent = contentArea
        local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0,3); l.Parent = f
        local p = Instance.new("UIPadding"); p.PaddingTop = UDim.new(0,6); p.PaddingLeft = UDim.new(0,6); p.PaddingRight = UDim.new(0,6); p.PaddingBottom = UDim.new(0,6); p.Parent = f
        return f
    end

    local function section(parent, text)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1,0,0,20); lbl.Text = "  " .. text
        lbl.TextColor3 = Color3.fromRGB(120,81,166); lbl.BackgroundColor3 = Color3.fromRGB(28,28,38)
        lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = parent
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = lbl
        return lbl
    end

    local function toggle(parent, label, path, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,0,0,26); btn.Text = label .. ": OFF"
        btn.BackgroundColor3 = Color3.fromRGB(32,32,44); btn.TextColor3 = Color3.fromRGB(200,200,200)
        btn.Font = Enum.Font.Gotham; btn.TextSize = 11; btn.Parent = parent
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = btn
        btn.MouseButton1Click:Connect(function()
            local t = Cfg
            for i=1,#path-1 do t = t[path[i]] end
            t[path[#path]] = not t[path[#path]]
            local on = t[path[#path]]
            btn.Text = label .. ": " .. (on and "ON" or "OFF")
            btn.BackgroundColor3 = on and (color or Color3.fromRGB(45,95,45)) or Color3.fromRGB(32,32,44)
            btn.TextColor3 = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
        end)
        return btn
    end

    local function slider(parent, label, path, min, max)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1,0,0,36); row.BackgroundColor3 = Color3.fromRGB(28,28,38); row.BorderSizePixel = 0; row.Parent = parent
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0,4); rc.Parent = row
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.6,0,0,16); lbl.Position = UDim2.new(0,6,0,2)
        lbl.Text = label; lbl.TextColor3 = Color3.fromRGB(220,220,220)
        lbl.BackgroundTransparency = 1; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
        local val = Instance.new("TextLabel")
        val.Size = UDim2.new(0.4,-6,0,16); val.Position = UDim2.new(0.6,0,0,2)
        val.Text = "0"; val.TextColor3 = Color3.fromRGB(120,81,166)
        val.BackgroundTransparency = 1; val.Font = Enum.Font.GothamBold; val.TextSize = 11
        val.TextXAlignment = Enum.TextXAlignment.Right; val.Parent = row
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1,-12,0,6); bar.Position = UDim2.new(0,6,0,24)
        bar.BackgroundColor3 = Color3.fromRGB(40,40,55); bar.BorderSizePixel = 0; bar.Parent = row
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,3); bc.Parent = bar
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0.5,0,1,0); fill.BackgroundColor3 = Color3.fromRGB(120,81,166); fill.BorderSizePixel = 0; fill.Parent = bar
        local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0,3); fc.Parent = fill
        -- init
        pcall(function()
            local t = Cfg
            for i=1,#path-1 do t = t[path[i]] end
            local v = t[path[#path]] or min
            val.Text = tostring(v)
            fill.Size = UDim2.new((v-min)/(max-min),0,1,0)
        end)
        -- drag
        local dragging = false
        bar.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if not dragging or i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            local rel = (i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
            rel = math.clamp(rel, 0, 1)
            local v = min + (max-min)*rel
            v = math.floor(v*100)/100
            local t = Cfg
            for i=1,#path-1 do t = t[path[i]] end
            t[path[#path]] = v
            val.Text = tostring(v)
            fill.Size = UDim2.new(rel,0,1,0)
        end)
        return row
    end

    local function dropdown(parent, label, path, options)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1,0,0,26); row.BackgroundColor3 = Color3.fromRGB(28,28,38); row.BorderSizePixel = 0; row.Parent = parent
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0,4); rc.Parent = row
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.5,0,1,0); lbl.Position = UDim2.new(0,6,0,0)
        lbl.Text = label; lbl.TextColor3 = Color3.fromRGB(220,220,220)
        lbl.BackgroundTransparency = 1; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.5,-6,0,20); btn.Position = UDim2.new(0.5,0,0,3)
        btn.Text = (function()
            local t = Cfg; for i=1,#path-1 do t=t[path[i]] end; return tostring(t[path[#path]])
        end)()
        btn.TextColor3 = Color3.fromRGB(255,255,255); btn.BackgroundColor3 = Color3.fromRGB(40,40,55)
        btn.Font = Enum.Font.Gotham; btn.TextSize = 10; btn.Parent = row
        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0,3); bc.Parent = btn
        local idx = 1
        btn.MouseButton1Click:Connect(function()
            idx = idx % #options + 1
            btn.Text = options[idx]
            local t = Cfg; for i=1,#path-1 do t=t[path[i]] end
            t[path[#path]] = options[idx]
        end)
        return row
    end

    -- build tabs
    for _, tabName in ipairs(TABS) do
        local tb = Instance.new("TextButton")
        tb.Size = UDim2.new(0, 70, 0, 24); tb.Text = tabName
        tb.TextColor3 = Color3.fromRGB(180,180,180); tb.BackgroundColor3 = Color3.fromRGB(32,32,44)
        tb.Font = Enum.Font.Gotham; tb.TextSize = 10; tb.Parent = tabBar
        local tbc = Instance.new("UICorner"); tbc.CornerRadius = UDim.new(0,4); tbc.Parent = tb
        local tf = makeTabFrame(tabName)
        tabButtons[tabName] = tb
        tabFrames[tabName] = tf
        tb.MouseButton1Click:Connect(function()
            for _, name in ipairs(TABS) do
                tabFrames[name].Visible = (name == tabName)
                if name == tabName then
                    tabButtons[name].BackgroundColor3 = Color3.fromRGB(120,81,166)
                    tabButtons[name].TextColor3 = Color3.fromRGB(255,255,255)
                else
                    tabButtons[name].BackgroundColor3 = Color3.fromRGB(32,32,44)
                    tabButtons[name].TextColor3 = Color3.fromRGB(180,180,180)
                end
            end
        end)
    end

    -- ============================================================
    -- AIMBOT TAB
    -- ============================================================
    local aimTab = tabFrames["Aimbot"]
    section(aimTab, "AIMBOT")
    toggle(aimTab, "Enabled", {"Combat","Aimbot","Enabled"}, Color3.fromRGB(200,60,60))
    slider(aimTab, "Smoothness", {"Combat","Aimbot","Smoothness"}, 0.01, 1)
    slider(aimTab, "FOV", {"Combat","Aimbot","FOV"}, 10, 360)
    dropdown(aimTab, "Target Part", {"Combat","Aimbot","Part"}, {"Head","UpperTorso","HumanoidRootPart"})
    toggle(aimTab, "Team Check", {"Combat","Aimbot","TeamCheck"})
    toggle(aimTab, "Wall Check", {"Combat","Aimbot","WallCheck"})
    toggle(aimTab, "On Scope Only", {"Combat","Aimbot","OnScope"})
    toggle(aimTab, "Prediction", {"Combat","Aimbot","Prediction"})
    slider(aimTab, "Prediction Amt", {"Combat","Aimbot","PredictionAmount"}, 0, 0.5)
    toggle(aimTab, "Flick", {"Combat","Aimbot","Flick"})
    section(aimTab, "RAGEBOT")
    toggle(aimTab, "Ragebot Enabled", {"Combat","Ragebot","Enabled"}, Color3.fromRGB(200,60,60))
    toggle(aimTab, "Auto Crouch", {"Combat","Ragebot","AutoCrouch"})
    toggle(aimTab, "Anti Knife", {"Combat","Ragebot","AntiKnife"})
    toggle(aimTab, "FFA Targeting", {"Combat","Ragebot","FFA"})
    section(aimTab, "ANTI-AIM")
    toggle(aimTab, "Anti-Aim Enabled", {"Combat","AntiAim","Enabled"}, Color3.fromRGB(200,60,60))
    dropdown(aimTab, "Pitch", {"Combat","AntiAim","Pitch"}, {"down","up"})
    dropdown(aimTab, "Yaw Mode", {"Combat","AntiAim","YawMode"}, {"jitter","spin","static"})

    -- ============================================================
    -- SILENT AIM TAB
    -- ============================================================
    local silentTab = tabFrames["Silent Aim"]
    section(silentTab, "SILENT AIM")
    toggle(silentTab, "Enabled", {"Combat","SilentAim","Enabled"}, Color3.fromRGB(200,60,60))
    slider(silentTab, "Hit Chance", {"Combat","SilentAim","HitChance"}, 0, 100)
    slider(silentTab, "FOV", {"Combat","SilentAim","FOV"}, 10, 360)
    dropdown(silentTab, "Closest Part", {"Combat","SilentAim","ClosestPart"}, {"Head","UpperTorso","HumanoidRootPart"})
    toggle(silentTab, "Team Check", {"Combat","SilentAim","TeamCheck"})
    toggle(silentTab, "Wall Check", {"Combat","SilentAim","WallCheck"})
    toggle(silentTab, "Visible Check", {"Combat","SilentAim","VisibleCheck"})
    toggle(silentTab, "Prediction", {"Combat","SilentAim","Prediction"})
    slider(silentTab, "Prediction Amt", {"Combat","SilentAim","PredictionAmount"}, 0, 0.5)
    toggle(silentTab, "Auto Shoot", {"Combat","SilentAim","AutoShoot"})
    toggle(silentTab, "Show Target", {"Combat","SilentAim","ShowTarget"})

    -- ============================================================
    -- TRIGGERBOT TAB
    -- ============================================================
    local trigTab = tabFrames["Triggerbot"]
    section(trigTab, "TRIGGERBOT")
    toggle(trigTab, "Enabled", {"Combat","Triggerbot","Enabled"}, Color3.fromRGB(200,60,60))
    slider(trigTab, "Delay", {"Combat","Triggerbot","Delay"}, 0, 0.5)
    slider(trigTab, "Shoot Delay", {"Combat","Triggerbot","ShootDelay"}, 0, 0.5)
    toggle(trigTab, "Team Check", {"Combat","Triggerbot","TeamCheck"})
    toggle(trigTab, "Head Only", {"Combat","Triggerbot","HeadOnly"})
    section(trigTab, "CHECKS")
    toggle(trigTab, "Shield Check", {"Combat","Triggerbot","Checks","Shield"})
    toggle(trigTab, "Katana Check", {"Combat","Triggerbot","Checks","Katana"})
    toggle(trigTab, "Wall Check", {"Combat","Triggerbot","Checks","Wall"})
    toggle(trigTab, "Sniper Scoped", {"Combat","Triggerbot","Checks","SniperScoped"})

    -- ============================================================
    -- ESP TAB — split: left settings, right spinning character preview
    -- ============================================================
    local espTab = tabFrames["ESP"]
    -- container for split layout
    local espContainer = Instance.new("Frame")
    espContainer.Size = UDim2.new(1,0,1,0); espContainer.BackgroundTransparency = 1; espContainer.Parent = espTab

    -- LEFT: settings scroll
    local espSettings = Instance.new("ScrollingFrame")
    espSettings.Size = UDim2.new(0.5,-4,1,-4); espSettings.Position = UDim2.new(0,0,0,0)
    espSettings.BackgroundTransparency = 1; espSettings.BorderSizePixel = 0
    espSettings.ScrollBarThickness = 3; espSettings.CanvasSize = UDim2.new(0,0,0,0)
    espSettings.AutomaticCanvasSize = Enum.AutomaticSize.Y; espSettings.Parent = espContainer
    local esl = Instance.new("UIListLayout"); esl.Padding = UDim.new(0,3); esl.Parent = espSettings
    local esp = Instance.new("UIPadding"); esp.PaddingTop = UDim.new(0,4); esp.PaddingLeft = UDim.new(0,2); esp.PaddingRight = UDim.new(0,2); esp.Parent = espSettings

    -- RIGHT: spinning character viewport
    local previewFrame = Instance.new("Frame")
    previewFrame.Size = UDim2.new(0.5,-4,1,-4); previewFrame.Position = UDim2.new(0.5,4,0,0)
    previewFrame.BackgroundColor3 = Color3.fromRGB(24,24,32); previewFrame.BorderSizePixel = 0; previewFrame.Parent = espContainer
    local pfc = Instance.new("UICorner"); pfc.CornerRadius = UDim.new(0,6); pfc.Parent = previewFrame
    local previewTitle = Instance.new("TextLabel")
    previewTitle.Size = UDim2.new(1,0,0,18); previewTitle.Text = "ESP Preview"
    previewTitle.TextColor3 = Color3.fromRGB(120,81,166); previewTitle.BackgroundTransparency = 1
    previewTitle.Font = Enum.Font.GothamBold; previewTitle.TextSize = 11; previewTitle.Parent = previewFrame

    local viewport = Instance.new("ViewportFrame")
    viewport.Size = UDim2.new(1,-8,1,-24); viewport.Position = UDim2.new(0,4,0,20)
    viewport.BackgroundColor3 = Color3.fromRGB(18,18,26); viewport.BorderSizePixel = 0
    viewport.Ambient = Color3.fromRGB(180,180,180); viewport.LightColor = Color3.fromRGB(255,255,255)
    viewport.LightDirection = Vector3.new(-1,-1,-1); viewport.Parent = previewFrame
    local vc = Instance.new("UICorner"); vc.CornerRadius = UDim.new(0,4); vc.Parent = viewport

    -- clone character into viewport
    local worldModel = Instance.new("WorldModel"); worldModel.Parent = viewport
    local cam = Instance.new("Camera"); cam.Parent = viewport
    viewport.CurrentCamera = cam

    local previewChar = nil
    local function setupPreview()
        pcall(function()
            if previewChar then previewChar:Destroy() end
            local char = LocalPlayer.Character
            if not char then return end
            local clone = char:Clone()
            clone.Parent = worldModel
            previewChar = clone
            -- position camera
            local root = clone:FindFirstChild("HumanoidRootPart")
            if root then
                cam.CFrame = CFrame.new(root.Position + Vector3.new(0,2,8), root.Position + Vector3.new(0,2,0))
            end
        end)
    end
    setupPreview()
    LocalPlayer.CharacterAdded:Connect(function() task.wait(1); setupPreview() end)

    -- spin the character
    local spinConn = RunService.Heartbeat:Connect(function(dt)
        if previewChar and previewChar:FindFirstChild("HumanoidRootPart") then
            local root = previewChar.HumanoidRootPart
            root.CFrame = root.CFrame * CFrame.Angles(0, dt*1.5, 0)
        end
    end)
    K.track(spinConn)

    -- ESP settings in left panel
    section(espSettings, "ESP MASTER")
    toggle(espSettings, "Enabled", {"ESP","Enabled"}, Color3.fromRGB(60,120,200))
    toggle(espSettings, "Team Check", {"ESP","TeamCheck"})
    toggle(espSettings, "Show Teammates", {"ESP","ShowTeammates"})
    slider(espSettings, "Max Distance", {"ESP","MaxDistance"}, 100, 10000)
    section(espSettings, "BOX")
    toggle(espSettings, "Box", {"ESP","Box","Enabled"})
    dropdown(espSettings, "Style", {"ESP","Box","Style"}, {"Full","Corner"})
    slider(espSettings, "Thickness", {"ESP","Box","Thickness"}, 1, 4)
    section(espSettings, "NAME")
    toggle(espSettings, "Name", {"ESP","Name","Enabled"})
    toggle(espSettings, "Use Display Name", {"ESP","Name","UseDisplayName"})
    slider(espSettings, "Size", {"ESP","Name","Size"}, 8, 24)
    section(espSettings, "HEALTH")
    toggle(espSettings, "Health Bar", {"ESP","HealthBar","Enabled"})
    dropdown(espSettings, "Color Mode", {"ESP","HealthBar","ColorMode"}, {"Solid","Gradient","Reactive"})
    section(espSettings, "TRACER")
    toggle(espSettings, "Tracer", {"ESP","Tracer","Enabled"})
    dropdown(espSettings, "From", {"ESP","Tracer","From"}, {"Bottom","Center","Top","Mouse"})
    dropdown(espSettings, "To", {"ESP","Tracer","To"}, {"Feet","Head"})
    section(espSettings, "CHAMS")
    toggle(espSettings, "Chams", {"ESP","Chams","Enabled"})
    dropdown(espSettings, "Kind", {"ESP","Chams","Kind"}, {"Legacy","Highlight"})
    toggle(espSettings, "Glow", {"ESP","Chams","Glow"})
    section(espSettings, "OTHER")
    toggle(espSettings, "Distance", {"ESP","Distance","Enabled"})
    toggle(espSettings, "Held Weapon", {"ESP","HeldWeapon","Enabled"})
    toggle(espSettings, "Skeleton", {"ESP","Skeleton","Enabled"})
    toggle(espSettings, "Head Marker", {"ESP","HeadMarker","Enabled"})
    toggle(espSettings, "Offscreen Arrow", {"ESP","OffscreenArrow","Enabled"})

    -- ============================================================
    -- MISC TAB
    -- ============================================================
    local miscTab = tabFrames["Misc"]
    section(miscTab, "MOVEMENT")
    toggle(miscTab, "WalkSpeed", {"Misc","WalkSpeed","Enabled"})
    slider(miscTab, "WalkSpeed Value", {"Misc","WalkSpeed","Value"}, 16, 100)
    toggle(miscTab, "JumpPower", {"Misc","JumpPower","Enabled"})
    slider(miscTab, "JumpPower Value", {"Misc","JumpPower","Value"}, 16, 100)
    toggle(miscTab, "Fly", {"Misc","Fly","Enabled"})
    slider(miscTab, "Fly Speed", {"Misc","Fly","Speed"}, 10, 200)
    toggle(miscTab, "Infinite Jump", {"Misc","InfiniteJump"})
    toggle(miscTab, "Thirdperson", {"Misc","Thirdperson","Enabled"})
    section(miscTab, "GUN MODS")
    toggle(miscTab, "No Recoil", {"Misc","NoRecoil"})
    toggle(miscTab, "No Spread", {"Misc","NoSpread"})
    toggle(miscTab, "Rapid Fire", {"Misc","RapidFire"})
    toggle(miscTab, "Automatic", {"Misc","Automatic"})
    toggle(miscTab, "No Muzzle Flash", {"Misc","NoMuzzleFlash"})
    toggle(miscTab, "No Fuse", {"Misc","NoFuse"})
    toggle(miscTab, "Auto Reload", {"Misc","AutoReload"})
    section(miscTab, "DETECTION")
    toggle(miscTab, "Staff Detector", {"Misc","StaffDetector","Enabled"}, Color3.fromRGB(200,60,60))
    toggle(miscTab, "Mod Detector", {"Misc","ModDetector","Enabled"}, Color3.fromRGB(200,60,60))
    section(miscTab, "OTHER")
    toggle(miscTab, "Anti Flash", {"Misc","AntiFlash"})
    toggle(miscTab, "Remove Smoke", {"Misc","RemoveSmoke"})
    toggle(miscTab, "No Scope Overlay", {"Misc","NoScopeOverlay"})
    toggle(miscTab, "Destroy Tripmine", {"Misc","DestroyTripmine","Enabled"})
    toggle(miscTab, "Hit Notify", {"Misc","HitNotify","Enabled"})

    -- ============================================================
    -- VISUALS TAB
    -- ============================================================
    local visTab = tabFrames["Visuals"]
    section(visTab, "FOV")
    toggle(visTab, "FOV Circle", {"Visuals","FOVCircle","Enabled"})
    slider(visTab, "FOV Radius", {"Visuals","FOVCircle","Radius"}, 30, 300)
    section(visTab, "CROSSHAIR")
    toggle(visTab, "Crosshair", {"Visuals","Crosshair","Enabled"})
    slider(visTab, "Size", {"Visuals","Crosshair","Size"}, 2, 20)
    slider(visTab, "Gap", {"Visuals","Crosshair","Gap"}, 0, 12)
    toggle(visTab, "Dot", {"Visuals","Crosshair","Dot"})
    section(visTab, "TARGET HUD")
    toggle(visTab, "Target HUD", {"Visuals","TargetHUD","Enabled"})
    section(visTab, "OVERLAY")
    toggle(visTab, "Hit Overlay", {"Visuals","HitOverlay","Enabled"})
    toggle(visTab, "Damage Numbers", {"Visuals","DamageNumbers","Enabled"})
    toggle(visTab, "Soul Particles", {"Visuals","SoulParticles","Enabled"})
    toggle(visTab, "Watermark", {"Visuals","Indicators","Watermark","Enabled"})
    section(visTab, "WORLD")
    toggle(visTab, "World Lighting", {"Visuals","World","Lighting","Enabled"})
    toggle(visTab, "No Textures", {"Visuals","World","NoTextures"})

    -- ============================================================
    -- CONFIGS TAB
    -- ============================================================
    local cfgTab = tabFrames["Configs"]
    section(cfgTab, "CONFIG MANAGEMENT")
    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1,0,0,40); info.Text = "Configs save to executor workspace.\nUse Save/Load buttons below."
    info.TextColor3 = Color3.fromRGB(180,180,180); info.BackgroundTransparency = 1
    info.Font = Enum.Font.Gotham; info.TextSize = 11; info.Parent = cfgTab
    local saveBtn = Instance.new("TextButton")
    saveBtn.Size = UDim2.new(1,0,0,28); saveBtn.Text = "Save Config"
    saveBtn.BackgroundColor3 = Color3.fromRGB(45,95,45); saveBtn.TextColor3 = Color3.fromRGB(255,255,255)
    saveBtn.Font = Enum.Font.GothamBold; saveBtn.TextSize = 12; saveBtn.Parent = cfgTab
    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(0,4); sc.Parent = saveBtn
    saveBtn.MouseButton1Click:Connect(function()
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local json = HttpService:JSONEncode(Cfg)
            if writefile then writefile("rivals_unified_config.json", json) end
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Config", Text = "Saved!", Duration = 3 })
        end)
    end)
    local loadBtn = Instance.new("TextButton")
    loadBtn.Size = UDim2.new(1,0,0,28); loadBtn.Text = "Load Config"
    loadBtn.BackgroundColor3 = Color3.fromRGB(45,45,95); loadBtn.TextColor3 = Color3.fromRGB(255,255,255)
    loadBtn.Font = Enum.Font.GothamBold; loadBtn.TextSize = 12; loadBtn.Parent = cfgTab
    local lc = Instance.new("UICorner"); lc.CornerRadius = UDim.new(0,4); lc.Parent = loadBtn
    loadBtn.MouseButton1Click:Connect(function()
        pcall(function()
            if isfile and isfile("rivals_unified_config.json") then
                local HttpService = game:GetService("HttpService")
                local data = readfile("rivals_unified_config.json")
                local decoded = HttpService:JSONDecode(data)
                for k,v in pairs(decoded) do Cfg[k] = v end
                game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Config", Text = "Loaded!", Duration = 3 })
            end
        end)
    end)
    local unloadBtn = Instance.new("TextButton")
    unloadBtn.Size = UDim2.new(1,0,0,28); unloadBtn.Text = "Unload Script"
    unloadBtn.BackgroundColor3 = Color3.fromRGB(95,45,45); unloadBtn.TextColor3 = Color3.fromRGB(255,255,255)
    unloadBtn.Font = Enum.Font.GothamBold; unloadBtn.TextSize = 12; unloadBtn.Parent = cfgTab
    local uc = Instance.new("UICorner"); uc.CornerRadius = UDim.new(0,4); uc.Parent = unloadBtn
    unloadBtn.MouseButton1Click:Connect(function() K.Unload(); sg:Destroy() end)

    -- show first tab
    tabButtons["Aimbot"].MouseButton1Click:Fire()

    -- draggable
    local dragging, dragStart, startPos
    titleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = i.Position; startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end
pcall(makeUI)

-- watermark
pcall(function()
    local sg = Instance.new("ScreenGui"); sg.Name = "Watermark"; sg.ResetOnSpawn = false; sg.Parent = gethui()
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0,200,0,20); lbl.Position = UDim2.new(0,10,0,10)
    lbl.Text = "Rivals Unified v3"; lbl.TextColor3 = Color3.fromRGB(120,81,166)
    lbl.BackgroundTransparency = 1; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 14
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = sg
end)

print("[RivalsUnified v3] loaded — tabbed UI with ESP character preview")
