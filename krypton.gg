        st.Transparency = 0.7
        st.Thickness = 1
        return card
    end

    local function addToggle(parent, text, cfg, key, onChange)
        local card = addCard(parent, 34)
        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(1, -70, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(235, 230, 250)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 2

        local sw = Instance.new("TextButton", card)
        sw.Size = UDim2.new(0, 40, 0, 20)
        sw.Position = UDim2.new(1, -52, 0.5, -10)
        sw.BackgroundColor3 = cfg[key] and CFG.UI.Accent or Color3.fromRGB(50, 42, 74)
        sw.Text = ""
        sw.AutoButtonColor = false
        sw.ZIndex = 2
        Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", sw)
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new(0, cfg[key] and 23 or 3, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.ZIndex = 2
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        sw.MouseButton1Click:Connect(function()
            local v = not cfg[key]
            cfg[key] = v
            sw.BackgroundColor3 = v and CFG.UI.Accent or Color3.fromRGB(50, 42, 74)
            pcall(function()
                knob:TweenPosition(UDim2.new(0, v and 23 or 3, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.12, true)
            end)
            if onChange then onChange(v) end
        end)
    end

    local function addSlider(parent, text, cfg, key, minV, maxV, integer, suffix)
        local card = addCard(parent, 54)
        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(0, 220, 0, 18)
        lbl.Position = UDim2.new(0, 12, 0, 6)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(235, 230, 250)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 2

        local val = Instance.new("TextLabel", card)
        val.Size = UDim2.new(0, 90, 0, 18)
        val.Position = UDim2.new(1, -102, 0, 6)
        val.BackgroundTransparency = 1
        val.Text = tostring(cfg[key]) .. (suffix or "")
        val.TextColor3 = CFG.UI.Accent
        val.TextSize = 14
        val.Font = Enum.Font.GothamBold
        val.TextXAlignment = Enum.TextXAlignment.Right
        val.ZIndex = 2

        local track = Instance.new("Frame", card)
        track.Size = UDim2.new(1, -24, 0, 6)
        track.Position = UDim2.new(0, 12, 0, 34)
        track.BackgroundColor3 = Color3.fromRGB(50, 42, 74)
        track.BorderSizePixel = 0
        track.ZIndex = 2
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new((cfg[key] - minV) / (maxV - minV), 0, 1, 0)
        fill.BackgroundColor3 = CFG.UI.Accent
        fill.BorderSizePixel = 0
        fill.ZIndex = 2
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", track)
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new((cfg[key] - minV) / (maxV - minV), -7, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.ZIndex = 2
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function apply(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = minV + (maxV - minV) * rel
            if integer then
                v = math.floor(v + 0.5)
            else
                v = math.floor(v * 100 + 0.5) / 100
            end
            cfg[key] = v
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -7, 0.5, -7)
            val.Text = tostring(v) .. (suffix or "")
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                apply(input)
            end
        end)
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        table.insert(state.conns, UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                apply(input)
            end
        end))
    end

    local function addColor(parent, text, cfg, key, onChange)
        local card = addCard(parent, 64)
        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(0, 170, 0, 20)
        lbl.Position = UDim2.new(0, 12, 0, 6)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(235, 230, 250)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 2

        local preview = Instance.new("Frame", card)
        preview.Size = UDim2.new(0, 22, 0, 22)
        preview.Position = UDim2.new(1, -172, 0, 4)
        preview.BackgroundColor3 = cfg[key]
        preview.BorderSizePixel = 0
        preview.ZIndex = 2
        Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 4)

        local box = Instance.new("TextBox", card)
        box.Size = UDim2.new(0, 128, 0, 24)
        box.Position = UDim2.new(1, -142, 0, 3)
        box.BackgroundColor3 = Color3.fromRGB(40, 32, 62)
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.PlaceholderText = "#RRGGBB"
        box.Text = toHex(cfg[key])
        box.TextSize = 13
        box.Font = Enum.Font.Code
        box.ClearTextOnFocus = false
        box.BorderSizePixel = 0
        box.ZIndex = 2
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

        local function applyColor(c)
            cfg[key] = c
            preview.BackgroundColor3 = c
            box.Text = toHex(c)
            if onChange then onChange(c) end
        end

        box.FocusLost:Connect(function()
            local parsed = parseHex(box.Text)
            if parsed then
                applyColor(parsed)
            else
                box.Text = toHex(cfg[key])
            end
        end)

        local swRow = Instance.new("Frame", card)
        swRow.Size = UDim2.new(1, -24, 0, 22)
        swRow.Position = UDim2.new(0, 12, 0, 36)
        swRow.BackgroundTransparency = 1
        swRow.ZIndex = 2
        local sl = Instance.new("UIListLayout", swRow)
        sl.FillDirection = Enum.FillDirection.Horizontal
        sl.Padding = UDim.new(0, 4)
        sl.SortOrder = Enum.SortOrder.LayoutOrder

        for i, c in ipairs(SWATCHES) do
            local sw = Instance.new("TextButton", swRow)
            sw.Size = UDim2.new(0, 20, 0, 20)
            sw.BackgroundColor3 = c
            sw.Text = ""
            sw.AutoButtonColor = false
            sw.LayoutOrder = i
            sw.ZIndex = 2
            Instance.new("UICorner", sw).CornerRadius = UDim.new(0, 4)
            sw.MouseButton1Click:Connect(function()
                applyColor(c)
            end)
        end
    end

    local function addCycle(parent, text, cfg, key, options)
        local card = addCard(parent, 36)
        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(0, 180, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(235, 230, 250)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 2

        local btn = Instance.new("TextButton", card)
        btn.Size = UDim2.new(0, 150, 0, 26)
        btn.Position = UDim2.new(1, -162, 0.5, -13)
        btn.BackgroundColor3 = Color3.fromRGB(40, 32, 62)
        btn.Text = tostring(cfg[key])
        btn.TextColor3 = CFG.UI.Accent
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0
        btn.ZIndex = 2
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local idx = 1
        for i, v in ipairs(options) do
            if v == cfg[key] then idx = i end
        end
        btn.MouseButton1Click:Connect(function()
            idx = idx % #options + 1
            cfg[key] = options[idx]
            btn.Text = tostring(cfg[key])
        end)
    end

