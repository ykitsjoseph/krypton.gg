local state = {
    open = true,
    aimHeld = false,
    silentHeld = false,
    trigHeld = false,
    firing = false,
    lastShot = 0,
    stickyPart = nil,
    stickyChar = nil,
    hookOk = false,
    drawingOk = false,
    bypass = false,
    aimTarget = nil,
    silentPos = nil,
    silentChar = nil,
    silentFallback = nil,
    trigTarget = nil,
    animT = 0,
    conns = {},
    esps = {},
    gui = {},
    pages = {},
    tabs = {},
