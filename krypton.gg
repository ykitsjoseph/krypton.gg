    local function makeTab(name, label, glyph)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(30, 24, 48)
        btn.BackgroundTransparency = 0.4
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.LayoutOrder = #state.tabs + 1
        btn.ZIndex = 2
        btn.Parent = sidebar

        local indicator = Instance.new("Frame", btn)
        indicator.Size = UDim2.new(0, 3, 0, 16)
        indicator.Position = UDim2.new(0, 2, 0.5, -8)
        indicator.BackgroundColor3 = CFG.UI.Accent
        indicator.BorderSizePixel = 0
        indicator.ZIndex = 3
        indicator.Visible = false

        local icon = Instance.new("Frame", btn)
        icon.Size = UDim2.new(0, 20, 0, 20)
        icon.Position = UDim2.new(0, 8, 0.5, -10)
        icon.BackgroundColor3 = Color3.fromRGB(50, 42, 74)
        icon.BorderSizePixel = 0
        icon.ZIndex = 2

        local iconTxt = Instance.new("TextLabel", icon)
        iconTxt.Size = UDim2.new(1, 0, 1, 0)
        iconTxt.BackgroundTransparency = 1
        iconTxt.Text = glyph
        iconTxt.TextColor3 = Color3.fromRGB(220, 210, 250)
        iconTxt.TextSize = 12
        iconTxt.Font = Enum.Font.GothamBold
        iconTxt.ZIndex = 2

        local lbl = Instance.new("TextLabel", btn)
        lbl.Size = UDim2.new(1, -46, 1, 0)
        lbl.Position = UDim2.new(0, 36, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(200, 190, 225)
        lbl.TextSize = 14
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 2

        btn.MouseEnter:Connect(function()
            if state.activeTab ~= name then
                pcall(function()
                    btn.BackgroundTransparency = 0.15
                end)
            end
        end)
        btn.MouseLeave:Connect(function()
            if state.activeTab ~= name then
                pcall(function()
                    btn.BackgroundTransparency = 0.4
                end)
            end
        end)

        state.tabs[name] = btn
        state.tabIndicators[name] = indicator
    end

    makeTab("aimbot", "Aimbot", "A")
    makeTab("triggerbot", "Triggerbot", "T")
    makeTab("silent", "Silent", "S")
    makeTab("exploits", "Exploits", "X")
    makeTab("movement", "Movement", "M")
    makeTab("visuals", "Visuals", "V")
    makeTab("world", "World", "W")
    makeTab("misc", "Misc", "?")
    makeTab("customize", "Customize", "C")
    makeTab("config", "Config", "K")

    local function switchTab(name)
        state.activeTab = name
        for n, page in pairs(state.pages) do
            page.Visible = (n == name)
        end
        for n, tab in pairs(state.tabs) do
            if n == name then
                tab.BackgroundColor3 = CFG.UI.Accent
                tab.BackgroundTransparency = 0.55
                local lbl = tab:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.TextColor3 = Color3.fromRGB(255, 255, 255) end
            else
                tab.BackgroundColor3 = Color3.fromRGB(30, 24, 48)
                tab.BackgroundTransparency = 0.4
                local lbl = tab:FindFirstChildOfClass("TextLabel")
                if lbl then lbl.TextColor3 = Color3.fromRGB(200, 190, 225) end
            end
        end
        for n, ind in pairs(state.tabIndicators) do
            ind.Visible = (n == name)
        end
    end

    for n, tab in pairs(state.tabs) do
        local tabName = n
        tab.MouseButton1Click:Connect(function() switchTab(tabName) end)
    end

    switchTab("aimbot")

    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    header.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    state.gui = { root = gui, main = main, stroke = stroke, stamp = stamp, barGradient = barGrad, toast = toast, toastStroke = toastStroke }
end

-- lifecycle

local loopName = "krypton_render"

local unload

unload = function()
    pcall(function() RunService:UnbindFromRenderStep(loopName) end)
    for _, c in ipairs(state.conns) do pcall(function() c:Disconnect() end) end
    state.conns = {}
    for _, e in pairs(state.esps) do destroyESP(e) end
    state.esps = {}
    state.stars = {}
    pcall(cleanupPorted)
    if fovCircle then pcall(function() fovCircle:Remove() end); fovCircle = nil end
    if state.gui.root then pcall(function() state.gui.root:Destroy() end) end
    state.gui = {}
end

local function startLoop()
    pcall(function() RunService:UnbindFromRenderStep(loopName) end)
    pcall(function()
        -- last priority: sample camera + parts AFTER every game script has moved them,
        -- so esp boxes/aim line up with the frame that is about to be drawn
        RunService:BindToRenderStep(loopName, Enum.RenderPriority.Last.Value - 1, function(dt)
            stepStars(dt)
            stepAimbot(dt)
            stepSilent()
            stepSilentFallback(dt)
            stepAntiAim(dt)
            stepFake(dt)
            stepMovement(dt)
            stepFOV()
            stepESP()
            stepChams()
            stepHitFeed(dt)
            stepHUD(dt)
            stepWorld(dt)
            stepStaff(dt)
            stepMisc(dt)
            stepTriggerbot()
        end)
    end)
end

pcall(buildUI)

table.insert(state.conns, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if keyMatches(input, CFG.Aimbot.Key) then state.aimHeld = true end
    if keyMatches(input, CFG.Silent.Key) then state.silentHeld = true end
    if keyMatches(input, CFG.Triggerbot.Key) then state.trigHeld = true end
    if input.KeyCode == CFG.UI.Toggle or input.KeyCode == Enum.KeyCode.Zero then
        state.open = not state.open
        if state.gui.main then state.gui.main.Visible = state.open end
    end
    if input.KeyCode == CFG.UI.Unload then
        unload()
    end
end))

table.insert(state.conns, UserInputService.InputEnded:Connect(function(input)
    if keyMatches(input, CFG.Aimbot.Key) then state.aimHeld = false end
    if keyMatches(input, CFG.Silent.Key) then state.silentHeld = false end
    if keyMatches(input, CFG.Triggerbot.Key) then state.trigHeld = false end
end))

pcall(tryHooks)
startLoop()
