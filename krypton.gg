--[[
krypton.lua
glass shell, cooler internals
tabs: aimbot / triggerbot / silent / exploits / movement / visuals / world / customize / config
extras: silent + anti-aim + desync, movement suite, chams, target hud, crosshair, hit sounds,
        staff detector, auto loadout/queue, world/lighting control, potato graphics,
        config save/load/export/import, skeleton esp, 0 toggles ui
controls: insert or 0 = toggle ui | hold aim key = aimbot + silent | hold trigger key = triggerbot | end = unload
--]]

