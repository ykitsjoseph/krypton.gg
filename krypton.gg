}

-- ============================================================
-- TARGET HUD
-- ============================================================
local targetHud = nil
local function createTargetHud()
    if targetHud then return targetHud end
    local sg = Instance.new("ScreenGui")
    sg.Name = "TargetHUD"; sg.ResetOnSpawn = false
    sg.Parent = gethui()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 80)
    frame.Position = UDim2.new(1, -240, 0.5, -40)
    frame.BackgroundColor3 = Color3.fromRGB(20,20,25)
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = sg
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,6); corner.Parent = frame
    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1,-10,0,20); name.Position = UDim2.new(0,5,0,5)
    name.Text = ""; name.TextColor3 = Color3.fromRGB(255,255,255)
    name.BackgroundTransparency = 1; name.Font = Enum.Font.GothamBold; name.TextSize = 14
    name.TextXAlignment = Enum.TextXAlignment.Left; name.Parent = frame
    local hp = Instance.new("TextLabel")
    hp.Size = UDim2.new(1,-10,0,16); hp.Position = UDim2.new(0,5,0,28)
    hp.Text = ""; hp.TextColor3 = Color3.fromRGB(50,220,90)
    hp.BackgroundTransparency = 1; hp.Font = Enum.Font.Gotham; hp.TextSize = 12
    hp.TextXAlignment = Enum.TextXAlignment.Left; hp.Parent = frame
    local dist = Instance.new("TextLabel")
    dist.Size = UDim2.new(1,-10,0,16); dist.Position = UDim2.new(0,5,0,48)
    dist.Text = ""; dist.TextColor3 = Color3.fromRGB(200,200,200)
    dist.BackgroundTransparency = 1; dist.Font = Enum.Font.Gotham; dist.TextSize = 12
    dist.TextXAlignment = Enum.TextXAlignment.Left; dist.Parent = frame
    targetHud = { gui = sg, frame = frame, name = name, hp = hp, dist = dist }
    return targetHud
end

local function targetHudTick()
    if not Cfg.Visuals.TargetHUD.Enabled then
        if targetHud then targetHud.frame.Visible = false end
        return
    end
    local hud = createTargetHud()
    local t = nil
    if Cfg.Combat.SilentAim.Enabled then t = SilentTarget end
    if not t and Cfg.Combat.Aimbot.Enabled then t = getBestTarget(Cfg.Combat.Aimbot, Cfg.Combat.Aimbot.Part) end
    if not t and Cfg.Combat.Ragebot.Enabled then t = getBestTarget({FOV=360,WallCheck=false}, "Head") end
    if t and t.player and t.part then
        hud.frame.Visible = true
        hud.name.Text = t.player.DisplayName or t.player.Name
        local hum = t.character:FindFirstChildOfClass("Humanoid")
        if hum then hud.hp.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) end
        local d = (t.part.Position - Camera.CFrame.Position).Magnitude
        hud.dist.Text = "Dist: " .. math.floor(d) .. "m"
    else
        hud.frame.Visible = false
    end
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
local heartbeat = RunService.Heartbeat:Connect(function(dt)
    if K.destroyed then return end
    pcall(silentAimTick)
    pcall(aimbotTick)
    pcall(triggerbotTick)
    pcall(function() if Cfg.Combat.Ragebot.Enabled then ragebotTick() end end)
    pcall(function() if Cfg.Combat.AntiAim.Enabled then antiAimTick() end end)
    pcall(espTick)
    pcall(fovTick)
    pcall(crosshairTick)
    pcall(miscTick)
    pcall(worldTick)
    pcall(staffDetectorTick)
    pcall(modDetectorTick)
    pcall(targetHudTick)
end)
K.track(heartbeat)

-- ============================================================
-- UNLOAD
-- ============================================================
function K.Unload()
    K.destroyed = true
    pcall(function() heartbeat:Disconnect() end)
    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    pcall(function() fovCircle:Remove() end)
    for _, l in ipairs(crossLines) do pcall(function() l:Remove() end) end
    pcall(function() crossDot:Remove() end)
    if targetHud then pcall(function() targetHud.gui:Destroy() end) end
    for _, c in ipairs(K.connections) do pcall(function() c:Disconnect() end) end
    for _, f in ipairs(K.cleanups) do pcall(f) end
end

-- ============================================================
-- UI (comprehensive toggle menu)
-- ============================================================
local function makeUI()
    local sg = Instance.new("ScreenGui")
    sg.Name = "RivalsUnifiedV2"; sg.ResetOnSpawn = false
    sg.Parent = gethui()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 520)
    frame.Position = UDim2.new(0, 20, 0.5, -260)
    frame.BackgroundColor3 = Color3.fromRGB(18,18,24)
    frame.BorderSizePixel = 0
    frame.Parent = sg
    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,8); corner.Parent = frame
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1,0,0,32); title.Text = "Rivals Unified v2"
    title.TextColor3 = Color3.fromRGB(255,255,255)
    title.BackgroundColor3 = Color3.fromRGB(28,28,38); title.Font = Enum.Font.GothamBold; title.TextSize = 14; title.Parent = frame
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0,8); tc.Parent = title
    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,-8,1,-40); scroll.Position = UDim2.new(0,4,0,36)
    scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 4; scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.Parent = frame
    local layout = Instance.new("UIListLayout"); layout.Padding = UDim.new(0,3); layout.Parent = scroll
    local pad = Instance.new("UIPadding"); pad.PaddingTop = UDim.new(0,4); pad.PaddingLeft = UDim.new(0,4); pad.PaddingRight = UDim.new(0,4); pad.Parent = scroll

    local function section(text)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1,0,0,20); lbl.Text = "  " .. text
        lbl.TextColor3 = Color3.fromRGB(120,81,166); lbl.BackgroundColor3 = Color3.fromRGB(28,28,38)
        lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = scroll
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = lbl
        return lbl
    end

    local function toggle(label, path, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,0,0,24); btn.Text = label .. ": OFF"
        btn.BackgroundColor3 = Color3.fromRGB(38,38,50); btn.TextColor3 = Color3.fromRGB(200,200,200)
        btn.Font = Enum.Font.Gotham; btn.TextSize = 11; btn.Parent = scroll
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,4); c.Parent = btn
        btn.MouseButton1Click:Connect(function()
            local t = Cfg
            for i=1,#path-1 do t = t[path[i]] end
            t[path[#path]] = not t[path[#path]]
            local on = t[path[#path]]
            btn.Text = label .. ": " .. (on and "ON" or "OFF")
            btn.BackgroundColor3 = on and (color or Color3.fromRGB(50,110,50)) or Color3.fromRGB(38,38,50)
            btn.TextColor3 = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,200,200)
        end)
    end

    section("COMBAT")
    toggle("Silent Aim", {"Combat","SilentAim","Enabled"}, Color3.fromRGB(200,60,60))
    toggle("Aimbot", {"Combat","Aimbot","Enabled"}, Color3.fromRGB(200,60,60))
    toggle("Triggerbot", {"Combat","Triggerbot","Enabled"}, Color3.fromRGB(200,60,60))
    toggle("Ragebot", {"Combat","Ragebot","Enabled"}, Color3.fromRGB(200,60,60))
    toggle("Anti-Aim", {"Combat","AntiAim","Enabled"}, Color3.fromRGB(200,60,60))

    section("ESP")
    toggle("ESP Master", {"ESP","Enabled"}, Color3.fromRGB(60,120,200))
    toggle("Box", {"ESP","Box","Enabled"})
    toggle("Name", {"ESP","Name","Enabled"})
    toggle("Health Bar", {"ESP","HealthBar","Enabled"})
    toggle("Tracer", {"ESP","Tracer","Enabled"})
    toggle("Chams", {"ESP","Chams","Enabled"})
    toggle("Distance", {"ESP","Distance","Enabled"})
    toggle("Held Weapon", {"ESP","HeldWeapon","Enabled"})
    toggle("Skeleton", {"ESP","Skeleton","Enabled"})
    toggle("Head Marker", {"ESP","HeadMarker","Enabled"})

    section("VISUALS")
    toggle("FOV Circle", {"Visuals","FOVCircle","Enabled"})
    toggle("Crosshair", {"Visuals","Crosshair","Enabled"})
    toggle("Target HUD", {"Visuals","TargetHUD","Enabled"})
    toggle("Hit Overlay", {"Visuals","HitOverlay","Enabled"})
    toggle("Damage Numbers", {"Visuals","DamageNumbers","Enabled"})
    toggle("Soul Particles", {"Visuals","SoulParticles","Enabled"})
    toggle("Watermark", {"Visuals","Indicators","Watermark","Enabled"})

    section("WORLD")
    toggle("World Lighting", {"Visuals","World","Lighting","Enabled"})
    toggle("No Textures", {"Visuals","World","NoTextures"})

    section("MOVEMENT")
    toggle("WalkSpeed", {"Misc","WalkSpeed","Enabled"})
    toggle("JumpPower", {"Misc","JumpPower","Enabled"})
    toggle("Fly", {"Misc","Fly","Enabled"})
    toggle("Infinite Jump", {"Misc","InfiniteJump"})
    toggle("Thirdperson", {"Misc","Thirdperson","Enabled"})
    toggle("Stretch Res", {"Misc","StretchResolution","Enabled"})

    section("MISC")
    toggle("No Recoil", {"Misc","NoRecoil"})
    toggle("No Spread", {"Misc","NoSpread"})
    toggle("Rapid Fire", {"Misc","RapidFire"})
    toggle("Automatic", {"Misc","Automatic"})
    toggle("No Muzzle Flash", {"Misc","NoMuzzleFlash"})
    toggle("Anti Flash", {"Misc","AntiFlash"})
    toggle("Remove Smoke", {"Misc","RemoveSmoke"})
    toggle("Auto Reload", {"Misc","AutoReload"})
    toggle("No Scope Overlay", {"Misc","NoScopeOverlay"})
    toggle("Destroy Tripmine", {"Misc","DestroyTripmine","Enabled"})
    toggle("Hit Notify", {"Misc","HitNotify","Enabled"})

    section("DETECTION")
    toggle("Staff Detector", {"Misc","StaffDetector","Enabled"}, Color3.fromRGB(200,60,60))
    toggle("Mod Detector", {"Misc","ModDetector","Enabled"}, Color3.fromRGB(200,60,60))

    section("SPOOF")
    toggle("Name Spoof", {"Misc","Spoof","Name","Enabled"})
    toggle("Level Spoof", {"Misc","Spoof","Level","Enabled"})
    toggle("Streak Spoof", {"Misc","Spoof","Streak","Enabled"})
    toggle("Rank Spoof", {"Misc","Spoof","Rank","Enabled"})

    -- draggable
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = i.Position; startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end
pcall(makeUI)

