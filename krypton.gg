--[[
krypton.lua
small rectangle ui, aimbot, esp, silent aim
executor: loadstring(game:HttpGet("URL"))()
controls: insert = toggle ui | right mouse = aimbot / silent aim | end = unload
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local CFG = {
    Aimbot = {
        Enabled = true,
        Silent = false,
        TeamCheck = true,
        WallCheck = true,
        Smooth = true,
        Smoothness = 0.3,
        FOVRadius = 160,
        Prediction = 0.1,
        Bone = "Head",
    },
    ESP = {
        Enabled = true,
        Boxes = true,
        Names = true,
        Distance = true,
        Health = true,
        Tracers = true,
        Chams = false,
        MaxDistance = 2500,
        BoxColor = Color3.fromRGB(0, 255, 255),
        NameColor = Color3.fromRGB(255, 255, 255),
        DistColor = Color3.fromRGB(200, 200, 200),
        HealthColor = Color3.fromRGB(0, 255, 0),
        TracerColor = Color3.fromRGB(255, 255, 255),
    },
    UI = {
        ToggleKey = Enum.KeyCode.Insert,
        UnloadKey = Enum.KeyCode.End,
        Accent = Color3.fromRGB(0, 255, 255),
        Background = Color3.fromRGB(15, 15, 20),
    },
}

local state = {
    UIOpen = true,
    MouseHeld = false,
    SilentTarget = nil,
    Connections = {},
    ESPData = {},
    GUI = {},
}

local function newDrawing(class, props)
    local ok, obj = pcall(function()
        local inst = Drawing.new(class)
        if props then
            for k, v in pairs(props) do inst[k] = v end
        end
        return inst
    end)
    return ok and obj or nil
end

local function remove(obj)
    if obj then pcall(function() obj:Remove() end) end
end

local function destroy(obj)
    if obj then pcall(function() obj:Destroy() end) end
end

local function getChar(p) return p and p.Character end
local function getRoot(c)
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChildWhichIsA("BasePart")
end
local function getHum(c)
    if not c then return nil end
    return c:FindFirstChildOfClass("Humanoid")
end
local function getBone(c, name)
    if not c then return nil end
    local part = c:FindFirstChild(name, true)
    if part then return part end
    return getRoot(c)
end

local function isEnemy(p)
    local myTeam = LocalPlayer.Team
    local theirTeam = p.Team
    if myTeam == nil or theirTeam == nil then return true end
    return theirTeam ~= myTeam
end

local function w2s(point)
    local cam = workspace.CurrentCamera
    if not cam then return nil, false, math.huge end
    local vp, onScreen, depth = cam:WorldToViewportPoint(point)
    return Vector2.new(vp.X, vp.Y), onScreen, depth
end

local function closestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local origin = cam.CFrame.Position
    local bestPart, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not isEnemy(p) then continue end
        local c = getChar(p)
        local h = getHum(c)
        local part = getBone(c, CFG.Aimbot.Bone)
        if not h or h.Health <= 0 or not part then continue end
        local pos, onScreen, depth = w2s(part.Position)
        if not onScreen then continue end
        if CFG.Aimbot.WallCheck then
            local ray = (part.Position - origin).Unit * depth
            local result = workspace:Raycast(origin, ray)
            if result and result.Instance and not result.Instance:IsDescendantOf(c) then continue end
        end
        local dist = (pos - center).Magnitude
        if dist > CFG.Aimbot.FOVRadius then continue end
        if dist < bestDist then
            bestDist = dist
            bestPart = part
        end
    end
    return bestPart
end

local function aimAt(part)
    if not part then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local target = part.Position
    local vel = part.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    target = target + vel * CFG.Aimbot.Prediction
    local desired = CFrame.lookAt(cam.CFrame.Position, target)
    if CFG.Aimbot.Smooth then
        cam.CFrame = cam.CFrame:Lerp(desired, CFG.Aimbot.Smoothness)
    else
        cam.CFrame = desired
    end
end

local function installSilentAim()
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    local ok2, setro = pcall(function() return setreadonly end)
    local old = mt.__namecall
    if ok2 then pcall(function() setro(mt, false) end) end
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }
        if state.MouseHeld and state.SilentTarget and CFG.Aimbot.Silent and self == workspace and method == "Raycast" then
            local origin = args[1]
            if origin then
                local dir = (state.SilentTarget - origin).Unit
                args[2] = dir * (args[2] and args[2].Magnitude or 1000)
            end
        end
        return old(self, unpack(args))
    end)
    if ok2 then pcall(function() setro(mt, true) end) end
end

local function buildESP(p)
    return {
        Box = newDrawing("Square", {Thickness = 2, Filled = false, Visible = false}),
        BoxOut = newDrawing("Square", {Thickness = 4, Filled = false, Color = Color3.new(0, 0, 0), Visible = false}),
        Name = newDrawing("Text", {Size = 16, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0), Visible = false}),
        Dist = newDrawing("Text", {Size = 14, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0), Visible = false}),
        Health = newDrawing("Line", {Thickness = 3, Visible = false}),
        HealthBack = newDrawing("Line", {Thickness = 5, Color = Color3.new(0, 0, 0), Visible = false}),
        Tracer = newDrawing("Line", {Thickness = 1.5, Visible = false}),
        Highlight = Instance.new("Highlight"),
    }
end

local function updateESP()
    if not CFG.ESP.Enabled then
        for _, d in pairs(state.ESPData) do
            d.Box.Visible = false
            d.BoxOut.Visible = false
            d.Name.Visible = false
            d.Dist.Visible = false
            d.Health.Visible = false
            d.HealthBack.Visible = false
            d.Tracer.Visible = false
            d.Highlight.Enabled = false
        end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not isEnemy(p) then continue end
        local c = getChar(p)
        local h = getHum(c)
        local root = getRoot(c)
        if not h or h.Health <= 0 or not root then
            local d = state.ESPData[p]
            if d then
                d.Box.Visible = false
                d.BoxOut.Visible = false
                d.Name.Visible = false
                d.Dist.Visible = false
                d.Health.Visible = false
                d.HealthBack.Visible = false
                d.Tracer.Visible = false
                d.Highlight.Enabled = false
                state.ESPData[p] = nil
            end
            continue
        end
        local pos, onScreen, depth = w2s(root.Position)
        if not onScreen or depth > CFG.ESP.MaxDistance then
            local d = state.ESPData[p]
            if d then
                d.Box.Visible = false
                d.BoxOut.Visible = false
                d.Name.Visible = false
                d.Dist.Visible = false
                d.Health.Visible = false
                d.HealthBack.Visible = false
                d.Tracer.Visible = false
                d.Highlight.Enabled = false
            end
            continue
        end
        local d = state.ESPData[p]
        if not d then
            d = buildESP(p)
            d.Highlight.Parent = c
            state.ESPData[p] = d
        end
        d.Highlight.Enabled = CFG.ESP.Chams
        d.Highlight.FillColor = CFG.ESP.BoxColor
        d.Highlight.OutlineColor = CFG.ESP.BoxColor
        d.Highlight.Adornee = c

        local head = c:FindFirstChild("Head")
        local top = head and head.Position or root.Position
        local topPos, topOn = w2s(top + Vector3.new(0, 0.7, 0))
        local botPos, botOn = w2s(root.Position - Vector3.new(0, 3, 0))

        if topOn and botOn then
            local height = math.abs(topPos.Y - botPos.Y)
            local width = height * 0.5
            local boxPos = Vector2.new(topPos.X - width / 2, topPos.Y)

            if CFG.ESP.Boxes then
                d.Box.Size = Vector2.new(width, height)
                d.Box.Position = boxPos
                d.Box.Color = CFG.ESP.BoxColor
                d.Box.Visible = true
                d.BoxOut.Size = Vector2.new(width, height)
                d.BoxOut.Position = boxPos
                d.BoxOut.Visible = true
            else
                d.Box.Visible = false
                d.BoxOut.Visible = false
            end

            if CFG.ESP.Names then
                d.Name.Text = p.Name .. " [" .. math.floor(h.Health) .. "hp]"
                d.Name.Position = Vector2.new(topPos.X, topPos.Y - 20)
                d.Name.Color = CFG.ESP.NameColor
                d.Name.Visible = true
            else
                d.Name.Visible = false
            end

            if CFG.ESP.Distance then
                d.Dist.Text = string.format("%dm", math.floor(depth))
                d.Dist.Position = Vector2.new(topPos.X, topPos.Y + height + 2)
                d.Dist.Color = CFG.ESP.DistColor
                d.Dist.Visible = true
            else
                d.Dist.Visible = false
            end

            if CFG.ESP.Health then
                local hp = math.clamp(h.Health / h.MaxHealth, 0, 1)
                local bh = height * hp
                d.Health.From = Vector2.new(boxPos.X - 8, botPos.Y - bh)
                d.Health.To = d.Health.From + Vector2.new(0, bh)
                d.Health.Color = CFG.ESP.HealthColor:Lerp(Color3.fromRGB(255, 0, 0), 1 - hp)
                d.Health.Visible = true
                d.HealthBack.From = d.Health.From - Vector2.new(0, 2)
                d.HealthBack.To = d.Health.From + Vector2.new(0, height + 2)
                d.HealthBack.Visible = true
            else
                d.Health.Visible = false
                d.HealthBack.Visible = false
            end

            if CFG.ESP.Tracers then
                d.Tracer.From = center
                d.Tracer.To = pos
                d.Tracer.Color = CFG.ESP.TracerColor
                d.Tracer.Visible = true
            else
                d.Tracer.Visible = false
            end
        else
            d.Box.Visible = false
            d.BoxOut.Visible = false
            d.Name.Visible = false
            d.Dist.Visible = false
            d.Health.Visible = false
            d.HealthBack.Visible = false
            d.Tracer.Visible = false
            d.Highlight.Enabled = false
        end
    end

    for p, d in pairs(state.ESPData) do
        if not p.Parent then
            d.Box:Remove()
            d.BoxOut:Remove()
            d.Name:Remove()
            d.Dist:Remove()
            d.Health:Remove()
            d.HealthBack:Remove()
            d.Tracer:Remove()
            d.Highlight:Destroy()
            state.ESPData[p] = nil
        end
    end
end

local fovCircle = nil
local function updateFOV()
    if not fovCircle then
        fovCircle = newDrawing("Circle", {Thickness = 2, Color = CFG.UI.Accent, Filled = false, Visible = false})
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    fovCircle.Radius = CFG.Aimbot.FOVRadius
    fovCircle.Visible = CFG.Aimbot.Enabled
end

local function buildUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "Krypton"
    gui.ResetOnSpawn = false
    local ok = pcall(function() gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end)
    if not ok then return nil end

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.Size = UDim2.new(0, 280, 0, 200)
    main.Position = UDim2.new(0.5, -140, 0.5, -100)
    main.BackgroundColor3 = CFG.UI.Background
    main.BorderSizePixel = 0
    main.Visible = state.UIOpen
    main.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = main

    local stroke = Instance.new("UIStroke")
    stroke.Color = CFG.UI.Accent
    stroke.Thickness = 2
    stroke.Parent = main

    local stamp = Instance.new("TextLabel")
    stamp.Name = "Stamp"
    stamp.Size = UDim2.new(0, 100, 0, 20)
    stamp.Position = UDim2.new(1, -110, 0, 5)
    stamp.BackgroundTransparency = 1
    stamp.Text = "krypton.gg"
    stamp.TextColor3 = CFG.UI.Accent
    stamp.TextSize = 16
    stamp.Font = Enum.Font.GothamBold
    stamp.TextXAlignment = Enum.TextXAlignment.Right
    stamp.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -110, 0, 24)
    title.Position = UDim2.new(0, 8, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "KRYPTO N"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 20
    title.Font = Enum.Font.GothamBlack
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = main

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -16, 1, -44)
    content.Position = UDim2.new(0, 8, 0, 38)
    content.BackgroundTransparency = 1
    content.Parent = main

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 6)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = content

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 6)
    pad.PaddingRight = UDim.new(0, 6)
    pad.Parent = content

    local function toggleRow(text, cfg, key)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(1, 0, 0, 26)
        f.BackgroundTransparency = 1
        f.LayoutOrder = #content:GetChildren()
        f.Parent = content

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -40, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.TextSize = 13
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = f

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 36, 0, 18)
        btn.Position = UDim2.new(1, -36, 0.5, -9)
        btn.BackgroundColor3 = cfg[key] and CFG.UI.Accent or Color3.fromRGB(45, 45, 55)
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = f

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(1, 0)
        btnCorner.Parent = btn

        local knob = Instance.new("Frame")
        knob.Size = UDim2.new(0, 14, 0, 14)
        knob.Position = UDim2.new(0, cfg[key] and 20 or 2, 0.5, -7)
        knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        knob.BorderSizePixel = 0
        knob.Parent = btn

        local knobCorner = Instance.new("UICorner")
        knobCorner.CornerRadius = UDim.new(1, 0)
        knobCorner.Parent = knob

        local active = cfg[key]
        btn.MouseButton1Click:Connect(function()
            active = not active
            cfg[key] = active
            btn.BackgroundColor3 = active and CFG.UI.Accent or Color3.fromRGB(45, 45, 55)
            knob.Position = UDim2.new(0, active and 20 or 2, 0.5, -7)
        end)
    end

    toggleRow("aimbot", CFG.Aimbot, "Enabled")
    toggleRow("silent aim", CFG.Aimbot, "Silent")
    toggleRow("esp", CFG.ESP, "Enabled")
    toggleRow("boxes", CFG.ESP, "Boxes")
    toggleRow("names", CFG.ESP, "Names")
    toggleRow("tracers", CFG.ESP, "Tracers")

    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    main.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)

    state.GUI = { Gui = gui, Main = main }
    return gui
end

local gui = buildUI()

local conns = {}

table.insert(conns, UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then state.MouseHeld = true end
    if input.KeyCode == CFG.UI.ToggleKey and gui then
        state.UIOpen = not state.UIOpen
        if state.GUI.Main then state.GUI.Main.Visible = state.UIOpen end
    end
    if input.KeyCode == CFG.UI.UnloadKey then unload() end
end))

table.insert(conns, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then state.MouseHeld = false end
end))

installSilentAim()

table.insert(conns, RunService.RenderStepped:Connect(function()
    updateESP()
    updateFOV()
    if CFG.Aimbot.Enabled and state.MouseHeld then
        local target = closestTarget()
        if target then
            state.SilentTarget = target.Position
            if not CFG.Aimbot.Silent then aimAt(target) end
        else
            state.SilentTarget = nil
        end
    else
        state.SilentTarget = nil
    end
end))

function unload()
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    for _, d in pairs(state.ESPData) do
        d.Box:Remove()
        d.BoxOut:Remove()
        d.Name:Remove()
        d.Dist:Remove()
        d.Health:Remove()
        d.HealthBack:Remove()
        d.Tracer:Remove()
        d.Highlight:Destroy()
    end
    state.ESPData = {}
    if fovCircle then remove(fovCircle); fovCircle = nil end
    if state.GUI.Gui then destroy(state.GUI.Gui); state.GUI = {} end
end
