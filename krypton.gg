-- Rivals — Unified Cheat Build (v3)
-- features: silent aim, aimbot, triggerbot, ragebot, anti-aim, ESP (box/name/health/tracer/chams/skeleton/distance/weapon/headmarker),
--           chams (highlight + legacy + glow), staff detector, mod detector, movement, gun mods, world visuals,
--           FOV circle, crosshair, target HUD, hit overlay, damage numbers, soul particles, watermark, configs
-- UI: tabbed — Aimbot, Silent Aim, Triggerbot, ESP (w/ live spinning character preview), Misc, Visuals, Configs
-- game: Roblox Rivals | Lua/Luau
-- run in any executor with getgenv()

if getgenv().RivalsUnified and getgenv().RivalsUnified.Unload then
    pcall(getgenv().RivalsUnified.Unload)
end
if not game:IsLoaded() then game.Loaded:Wait() end

local K = { connections = {}, cleanups = {}, destroyed = false }
getgenv().RivalsUnified = K

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Camera = Workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

local function cloneref(x) return x end
local function safe(fn, ...) local ok,r = pcall(fn,...); return ok and r or nil end
local function gethui() local ok,h = pcall(function() return gethui and gethui() end); return ok and h or game:GetService("CoreGui") end

