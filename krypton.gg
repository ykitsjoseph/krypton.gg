-- handled via controller hooks where possible; flags stored for external use
local gunMods = {
    NoRecoil = function() return Cfg.Misc.NoRecoil end,
    NoSpread = function() return Cfg.Misc.NoSpread end,
    RapidFire = function() return Cfg.Misc.RapidFire end,
