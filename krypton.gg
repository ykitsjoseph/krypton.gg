--[[
krypton.lua
same 720x480 glass shell, cooler internals
tabs: aimbot / triggerbot / silent / visuals / customize / config
extras: potato graphics, config save/load/export/import, skeleton esp, 0 toggles ui
controls: insert or 0 = toggle ui | hold aim key = aimbot + silent | hold trigger key = triggerbot | end = unload
--]]

