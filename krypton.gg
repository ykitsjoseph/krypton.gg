-- Rivals — Unified Cheat Build (v2)
-- features: silent aim (w/ prediction), aimbot, triggerbot, ragebot, anti-aim,
--           ESP (box/name/health/tracer/chams/distance), chams (highlight + legacy),
--           staff detector, mod detector, movement (fly/walkspeed/jumppower/infjump/thirdperson),
--           gun mods (norecoil/nospread/rapidfire/automatic), world visuals, FOV circle, crosshair
-- game: Roblox Rivals | Lua/Luau
-- run in any executor with getgenv()

if getgenv().RivalsUnified and getgenv().RivalsUnified.Unload then
    pcall(getgenv().RivalsUnified.Unload)
end
if not game:IsLoaded() then game.Loaded:Wait() end

local K = { connections = {}, cleanups = {}, destroyed = false }
getgenv().RivalsUnified = K

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local Camera = Workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

local function cloneref(x) return x end
local function safe(fn, ...) local ok,r = pcall(fn,...); return ok and r or nil end
local function gethui() local ok,h = pcall(function() return gethui and gethui() end); return ok and h or game:GetService("CoreGui") end

