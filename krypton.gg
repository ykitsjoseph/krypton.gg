--[[
krypton.lua
roblox executor script — aimbot + esp + silent aim + ui
host at: https://raw.githubusercontent.com/ykitsjoseph/krypton.gg/refs/heads/main/krypton.gg
loader: loadstring(game:HttpGet("URL"))()
controls: insert = toggle ui | right mouse = aimbot | end = unload
target-agnostic: runs on rivals or any place, no game-specific offsets
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Mouse = LocalPlayer:GetMouse()

local CFG = {
    Aimbot = {
        Enabled = true,
        Silent = false,
        TeamCheck = true,
        WallCheck = true,
        Smooth = true,
        Smoothness = 0.35,
        FOVRadius = 180,
        Prediction = 0.12,
        Bone = "Head",
        Key = Enum.UserInputType.MouseButton2,
    },
    ESP = {
        Enabled = true,
        Boxes = true,
        Names = true,
        Distance = true,
        Health = true,
        Tracers = true,
        Chams = false,
        MaxDistance = 2500,
        BoxColor = Color3.fromRGB(0, 255, 255),
        NameColor = Color3.fromRGB(255, 255, 255),
        DistColor = Color3.fromRGB(200, 200, 200),
        HealthColor = Color3.fromRGB(0, 255, 0),
        TracerColor = Color3.fromRGB(255, 255, 255),
        ChamsColor = Color3.fromRGB(255, 0, 255),
    },
    SilentAim = {
        Enabled = false,
        HitChance = 100,
        TargetPart = "Head",
        TeamCheck = true,
    },
    UI = {
        ToggleKey = Enum.KeyCode.Insert,
        UnloadKey = Enum.KeyCode.End,
        Accent = Color3.fromRGB(0, 255, 255),
        Background = Color3.fromRGB(15, 15, 20),
        Panel = Color3.fromRGB(25, 25, 35),
    },
}

local state = {
    UIOpen = true,
    AimbotActive = false,
    MouseHeld = false,
    SilentTarget = nil,
    Connections = {},
    Drawings = {},
    ESPData = {},
    GUI = {},
}

local function newDrawing(className, props)
    local ok, obj = pcall(function()
        local inst = Drawing.new(className)
        if props then
            for k, v in pairs(props) do inst[k] = v end
        end
        return inst
    end)
    return ok and obj or nil
end

local function removeDrawing(obj)
    if obj then pcall(function() obj:Remove() end) end
end

local function getCharacter(player) return player and player.Character end
local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
end
local function getHumanoid(char)
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end
local function getBone(char, name)
    if not char then return nil end
    local part = char:FindFirstChild(name, true)
    if part then return part end
    return getRoot(char)
end

local function isEnemy(player)
    local myTeam = LocalPlayer.Team
    local theirTeam = player.Team
    if myTeam == nil or theirTeam == nil then return true end
    return theirTeam ~= myTeam
end

local function worldToScreen(point)
    local cam = workspace.CurrentCamera
    if not cam then return nil, false, math.huge end
    local vp, onScreen, depth = cam:WorldToViewportPoint(point)
    return Vector2.new(vp.X, vp.Y), onScreen, depth
end

local function getClosestToCrosshair()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local origin = cam.CFrame.Position
    local bestPart, bestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then continue end
        local char = getCharacter(player)
        local hum = getHumanoid(char)
        local part = getBone(char, CFG.Aimbot.Bone)
        if not hum or hum.Health <= 0 or not part then continue end
        local pos, onScreen, depth = worldToScreen(part.Position)
        if not onScreen then continue end
        if CFG.Aimbot.WallCheck then
            local rayDir = (part.Position - origin).Unit * depth
            local result = workspace:Raycast(origin, rayDir)
            if result and result.Instance and not result.Instance:IsDescendantOf(char) then continue end
        end
        local dist = (pos - center).Magnitude
        if dist > CFG.Aimbot.FOVRadius then continue end
        if dist < bestDist then
            bestDist = dist
            bestPart = part
        end
    end
    return bestPart
end

-- silent aim ray redirect hook

local function installSilentAimHook()
    local ok, mt = pcall(getrawmetatable, game)
    if not ok or not mt then return end
    local old = mt.__namecall
    local ok2 = pcall(function()
        local sr = getrawmetatable(game).__namecall and setreadonly
        return sr
    end)
    if ok2 then pcall(function() setreadonly(mt, false) end) end
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = { ... }
        if state.MouseHeld and state.SilentTarget and method == "Raycast" and self == workspace and CFG.SilentAim.Enabled then
            local origin = args[1]
            if origin then
                local dir = (state.SilentTarget - origin).Unit
                args[2] = dir * (args[2] and args[2].Magnitude or 1000)
            end
        end
        return old(self, unpack(args))
    end)
    if ok2 then pcall(function() setreadonly(mt, true) end) end
end

-- esp drawing set

local function buildESP(player)
    return {
        Box = newDrawing("Square", {Thickness = 2, Filled = false, Visible = false}),
        BoxOutline = newDrawing("Square", {Thickness = 4, Filled = false, Color = Color3.new(0, 0, 0), Visible = false}),
        Name = newDrawing("Text", {Size = 18, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0), Visible = false}),
        Dist = newDrawing("Text", {Size = 16, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0), Visible = false}),
        HealthBar = newDrawing("Line", {Thickness = 3, Visible = false}),
        HealthBarBack = newDrawing("Line", {Thickness = 5, Color = Color3.new(0, 0, 0), Visible = false}),
        Tracer = newDrawing("Line", {Thickness = 1.5, Visible = false}),
        Highlight = Instance.new("Highlight"),
    }
end

local function updateESP()
    if not CFG.ESP.Enabled then
        for _, data in pairs(state.ESPData) do
            data.Box.Visible = false
            data.BoxOutline.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            data.HealthBar.Visible = false
            data.HealthBarBack.Visible = false
            data.Tracer.Visible = false
            data.Highlight.Enabled = false
        end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    Camera = cam
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not isEnemy(player) then continue end
        local char = getCharacter(player)
        local hum = getHumanoid(char)
        local root = getRoot(char)
        if not hum or hum.Health <= 0 or not root then
            local data = state.ESPData[player]
            if data then
                data.Box.Visible = false
                data.BoxOutline.Visible = false
                data.Name.Visible = false
                data.Dist.Visible = false
                data.HealthBar.Visible = false
                data.HealthBarBack.Visible = false
                data.Tracer.Visible = false
                data.Highlight.Enabled = false
                state.ESPData[player] = nil
            end
            continue
        end
        local pos, onScreen, depth = worldToScreen(root.Position)
        if not onScreen or depth > CFG.ESP.MaxDistance then
            local data = state.ESPData[player]
            if data then
                data.Box.Visible = false
                data.BoxOutline.Visible = false
                data.Name.Visible = false
                data.Dist.Visible = false
                data.HealthBar.Visible = false
                data.HealthBarBack.Visible = false
                data.Tracer.Visible = false
                data.Highlight.Enabled = false
            end
            continue
        end
        local data = state.ESPData[player]
        if not data then
            data = buildESP(player)
            data.Highlight.Parent = char
            state.ESPData[player] = data
        end
        data.Highlight.Enabled = CFG.ESP.Chams
        data.Highlight.FillColor = CFG.ESP.ChamsColor
        data.Highlight.OutlineColor = CFG.ESP.ChamsColor
        data.Highlight.Adornee = char

        local head = char:FindFirstChild("Head")
        local top = head and head.Position or root.Position
        local topPos, topOn = worldToScreen(top + Vector3.new(0, 0.7, 0))
        local bottomPos, bottomOn = worldToScreen(root.Position - Vector3.new(0, 3, 0))

        if topOn and bottomOn then
            local height = math.abs(topPos.Y - bottomPos.Y)
            local width = height * 0.55
            local boxPos = Vector2.new(topPos.X - width / 2, topPos.Y)

            if CFG.ESP.Boxes then
                data.Box.Size = Vector2.new(width, height)
                data.Box.Position = boxPos
                data.Box.Color = CFG.ESP.BoxColor
                data.Box.Visible = true
                data.BoxOutline.Size = Vector2.new(width, height)
                data.BoxOutline.Position = boxPos
                data.BoxOutline.Visible = true
            else
                data.Box.Visible = false
                data.BoxOutline.Visible = false
            end

            if CFG.ESP.Names then
                data.Name.Text = player.Name .. " [" .. math.floor(hum.Health) .. "hp]"
                data.Name.Position = Vector2.new(topPos.X, topPos.Y - 22)
                data.Name.Color = CFG.ESP.NameColor
                data.Name.Visible = true
            else
                data.Name.Visible = false
            end

            if CFG.ESP.Distance then
                data.Dist.Text = string.format("%dm", math.floor(depth))
                data.Dist.Position = Vector2.new(topPos.X, topPos.Y + height + 2)
                data.Dist.Color = CFG.ESP.DistColor
                data.Dist.Visible = true
            else
                data.Dist.Visible = false
            end

            if CFG.ESP.Health then
                local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local barHeight = height * hpPercent
                local barPos = Vector2.new(boxPos.X - 8, bottomPos.Y - barHeight)
                data.HealthBar.From = barPos
                data.HealthBar.To = barPos + Vector2.new(0, barHeight)
                data.HealthBar.Color = CFG.ESP.HealthColor:Lerp(Color3.fromRGB(255, 0, 0), 1 - hpPercent)
                data.HealthBar.Visible = true
                data.HealthBarBack.From = barPos - Vector2.new(0, 2)
                data.HealthBarBack.To = barPos + Vector2.new(0, height + 2)
                data.HealthBarBack.Visible = true
            else
                data.HealthBar.Visible = false
                data.HealthBarBack.Visible = false
            end

            if CFG.ESP.Tracers then
                data.Tracer.From = center
                data.Tracer.To = pos
                data.Tracer.Color = CFG.ESP.TracerColor
                data.Tracer.Visible = true
            else
                data.Tracer.Visible = false
            end
        else
            data.Box.Visible = false
            data.BoxOutline.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            data.HealthBar.Visible = false
            data.HealthBarBack.Visible = false
            data.Tracer.Visible = false
            data.Highlight.Enabled = false
        end
    end

    for player, data in pairs(state.ESPData) do
        if not player.Parent then
            data.Box:Remove()
            data.BoxOutline:Remove()
            data.Name:Remove()
            data.Dist:Remove()
            data.HealthBar:Remove()
            data.HealthBarBack:Remove()
            data.Tracer:Remove()
            data.Highlight:Destroy()
            state.ESPData[player] = nil
        end
    end
end

-- fov circle

local fovCircle = nil

local function updateFOV()
    if not fovCircle then
        fovCircle = newDrawing("Circle", {Thickness = 2, Color = CFG.UI.Accent, Filled = false, Visible = false})
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    fovCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    fovCircle.Radius = CFG.Aimbot.FOVRadius
    fovCircle.Visible = CFG.Aimbot.Enabled
end

-- aimbot

local function aimAt(part)
    if not part then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local targetPos = part.Position
    local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
    local vel = part.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    targetPos = targetPos + vel * CFG.Aimbot.Prediction
    local desired = CFrame.lookAt(cam.CFrame.Position, targetPos)
    if CFG.Aimbot.Smooth then
        cam.CFrame = cam.CFrame:Lerp(desired, CFG.Aimbot.Smoothness)
    else
        cam.CFrame = desired
    end
end

